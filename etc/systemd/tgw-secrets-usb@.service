[Unit]
Description=TGW secrets bundle sync to USB key %i (PP-BACKUP-001 A3)
# Triggered when a TGW-SECRETS USB drive mounts.
# Both rotation drives carry the same LABEL=TGW-SECRETS; UUID in the log
# identifies which physical drive received the copy.
#
# Wire the trigger (done automatically by bin/tgw-secrets-usb-prep):
#   ESCAPED=$(systemd-escape --path /media/tgw/TGW-SECRETS)
#   mkdir -p /etc/systemd/system/${ESCAPED}.mount.d
#   echo -e '[Unit]\nWants=tgw-secrets-usb@TGW-SECRETS.service' \
#     > /etc/systemd/system/${ESCAPED}.mount.d/tgw-sync.conf
#   systemctl daemon-reload
#
# fstab entry (added by tgw-secrets-usb-prep):
#   LABEL=TGW-SECRETS  /media/tgw/TGW-SECRETS  ext4  noauto,nofail,users  0 0
#
# Instance %i is TGW-SECRETS; the same service fires for all drives with that label.

[Service]
Type=oneshot
User=tgw
Group=tgw
WorkingDirectory=/opt/TGW
ExecStart=/opt/TGW/current/bin/tgw-secrets-usb-sync %i

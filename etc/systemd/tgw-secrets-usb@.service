[Unit]
Description=TGW secrets bundle sync to USB key %i (PP-BACKUP-001 A3)
# Triggered when TGW-SECRETS-A or TGW-SECRETS-B mounts.
# Instance name (%i) is the partition label.
#
# Wire the trigger (replaces tgw-offline-sync in the mount drop-in):
#   ESCAPED=$(systemd-escape --path /media/tgw/TGW-SECRETS-A)
#   DIR=/etc/systemd/system/${ESCAPED}.mount.d
#   mkdir -p "$DIR"
#   echo -e '[Unit]\nWants=tgw-secrets-usb@TGW-SECRETS-A.service' > "$DIR/tgw-sync.conf"
#   systemctl daemon-reload

[Service]
Type=oneshot
User=tgw
Group=tgw
WorkingDirectory=/opt/TGW
ExecStart=/opt/TGW/src/trader-grims-warehouse/bin/tgw-secrets-usb-sync %i

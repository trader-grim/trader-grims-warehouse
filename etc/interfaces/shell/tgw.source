tgwgdrive_commands () {
#clear
#if  [ -d /media/db/BACKUP/TGW/ItemData ] ; then
echo Begin Google Drive Backup
echo transfering TGW Data
rclone sync $itemcatalog dbukove:/TGW/data/ItemCatalog/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
rclone sync $tgwpath/src dbukove:/TGW/src/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
rclone sync $tgwpath/bin dbukove:/TGW/bin/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
rclone sync $tgwpath/config dbukove:/TGW/config/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
rclone sync $tgwpath/docs dbukove:/TGW/docs/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
rclone sync $itemdatapath dbukove:/TGW/data/ItemData/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
#echo transfering ItemArchive
#rclone sync $itemarchivepath dbukove:/TGW/data/ItemArchive/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
#echo transfering logs
#rclone sync $tgwlogpath dbukove:/TGW/logs/ -P --tpslimit 3 --drive-stop-on-upload-limit --fast-list
echo Google Drive Backup Completed
#else
#echo BACKUP device not mounted. Mount BACKUP device and retry.
#fi
}

tgwbackup () {
mount /media/db/Backup
if  [ -d /media/db/Backup/TGW ] ; then
echo Begin Backup
rclone sync $itemarchivepath /media/db/Backup/TGW/ItemArchive -P
rclone sync $itemdatapath /media/db/Backup/TGW/ItemData -P
rclone sync $tgwlogpath /media/db/Backup/TGW/logs -P
rm -r /media/db/Backup/TGW/ItemCatalog
rsync -ahl $itemcatalogpath /media/db/Backup/TGW/
echo Backup Completed
else
echo No BACKUP drive found. Insert BACKUP device and retry.
fi
}

tgwclone () {
if  [ -d /media/db/TGW1 ] ; then
echo Begin Cloning TGW Data
rclone sync /media/db/TGW/ItemData /media/db/TGW1/ItemData -P
rm -r /media/db/TGW1/ItemCatalog
rsync -ahl /media/db/TGW/ItemCatalog /media/db/TGW1/
echo Cloning Completed
else
echo Aborted. Mount the TGW device and retry.
fi
}

upload () {
rclone copy $itemdatapath/ --include=/tgw`date +"%Y%m"`*/** dbukove:/TGW/ItemData/ -v
rclone copy $tgwpath/tgw.source.zip dbukove:/TGW/ -v
}


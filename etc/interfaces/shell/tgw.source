zip -qqumj $itemarchivepath/$1.zip $itemdatapath/$1/*.json.* $itemdatapath/$1/*.json $itemdatapath/$1/*.data $itemdatapath/$1/.bak $itemdatapath/$1/*data.txt $itemdatapath/$1/desktop.ini $itemdatapath/$1/.picasa.ini $itemdatapath/$1/.st*
unzip -qq $itemarchivepath/$1.zip $1.json -d $itemdatapath/$1
#unzip -qq $itemarchivepath/$1.zip $itemdatapath/$1-data_combined.json -d $itemdatapath/$1
}



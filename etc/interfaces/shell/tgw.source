#echo sku is $sku
#jq -r --arg s `tgw_sku` ' .qty // ."Available quantity" // ."`tgw_sku`"[0] ."Available quantity" // ."`tgw_sku`"[0] .qty' $itemdatapath/`tgw_sku`/`tgw_sku`.json
#jq -r --arg s $sku 'if (.qty // ."Available quantity") < 0 then .qty = 0 else . end'  $itemdatapath/$sku/$sku.json
#jq -r --arg s $sku 'if (.qty // ."Available quantity" // .Quantity // ."$sku"[0]."Available quantity" // ."$sku"[0].qty) < 0 or (.qty // ."Available quantity" // ."$sku"[0]."Available quantity" // ."$sku"[0].qty) == "" or (.qty // ."Available quantity" // ."$sku"[0]."Available quantity" // ."$sku"[0].qty) == null then 0 else .qty // ."Available quantity" // ."$sku"[0]."Available quantity" // ."$sku"[0].qty end' $itemdatapath/$sku/$sku.json
#jq -r --arg s tgw202304231634280 'if (.qty // ."Available quantity" // ."tgw202304231634280"[0] ."Available quantity" // ."tgw202304231634280"[0] .qty) < 0 or (.qty // ."Available quantity" // ."tgw202304231634280"[0] ."Available quantity" // ."tgw202304231634280"[0] .qty) == "" or (.qty // ."Available quantity" // ."tgw202304231634280"[0] ."Available quantity" // ."tgw202304231634280"[0] .qty) == null then 0 else .qty // ."Available quantity" // ."tgw202304231634280"[0] ."Available quantity" // ."tgw202304231634280"[0] .qty end' $itemdatapath/tgw202304231634280/tgw202304231634280.json
jq -r ' .qty // ."Available quantity" // ."$sku"[0] ."Available quantity" // ."$sku"[0] .qty' $itemdatapath/$sku/$sku.json | awk '{if ($1 <= 0 || $1 == "" || $1 == "null") print 0; else print $1}'
}

tgw_brand () {
jq -r --arg s `tgw_sku` ' ."C:Brand" // .brand // ."`tgw_sku`"[0] ."C:Brand" // ."`tgw_sku`"[0] .brand' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_model () {
jq -r --arg s `tgw_sku` ' ."C:Model" // .model_number // ."`tgw_sku`"[0] ."C:Model" // ."`tgw_sku`"[0] .model_number' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_mpn () {
jq -r --arg s `tgw_sku` ' ."C:MPN" // .part_number // ."`tgw_sku`"[0] ."C:MPN" // ."`tgw_sku`"[0] .part_number' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_price () {
jq -r --arg s `tgw_sku` ' .price // ."Start price" // ."Current price" // ."Buy It Now price" // ."`tgw_sku`"[0] .price // ."`tgw_sku`"[0]."Buy It Now price" // ."$sku"[0]."Current price"' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

current_price () {
gsku=$(tgw getsku $1)
jq -r --arg sku $gsku ' ."Current price" // .price // ."Start price" // ."Buy It Now price" // ."$sku"[0]."Buy It Now price" // ."$sku"[0]."Current price" // ."$sku"[0] .price' $itemdatapath/$gsku/$gsku.json
}

ebay_price () {
jq -r --arg s `tgw_sku` ' ."Buy It Now price" // ."Current price" // ."Start price" // ."`tgw_sku`"[0] ."Buy It Now price"' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

ebay_category_1_name () {
jq -r --arg s `tgw tgw_sku` " ."eBay category 1 name" // .category // ."`tgw_sku`"[0]."eBay category 1 name" // ."`tgw_sku`"[0].category" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

ebay_category_1_number () {
jq -r --arg s `tgw_sku` ' ."eBay category 1 number" // .category // ."`tgw_sku`"[0]."eBay category 1 number" // ."`tgw_sku`"[0] .category // 156532' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

ebay_category_2_name () {
jq -r --arg s `tgw_sku` ' ."eBay category 2 name" // .category // ."`tgw_sku`"[0]."eBay category 2 name" // ."`tgw_sku`"[0].category' $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

ebay_category_2_number () {
jq -r --arg s `tgw_sku` ' ."eBay category 2 number" // .category // ."`tgw tgw_sku`"[0]."eBay category 2 number" // ."`tgw_sku`"[0] .category' $itemdatapath/`tgw tgw_sku`/`tgw tgw_sku`.json
}

ebay_condition () {
cat  $itemdatapath/`tgw_sku`/`tgw_sku`.json |jq -r --arg s "$s" " .condition // ."$s"[0].condition //  .Condition // ."$s"[0].Condition // 'GOOD'"
}

ebay_condition_description () {
jq -r --arg s `tgw_sku` " .condition_description // ."`tgw_sku`"[0].condition_description" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}


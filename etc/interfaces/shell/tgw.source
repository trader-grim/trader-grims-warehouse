}

fixnodata () {
echo " Checking nodata error:"
if [[ "`jq -r .sku $itemdatapath/$1/$1.json`" != "$1" ]] ; then
echo Fixing `jq -r .sku $itemdatapath/$1/$1.json` $1 nodata error
for process in unarchivedata data2json archivedata ; do
    tgw $process $1
done
fi
#echo ---command
}

fixemptytitle () {
sku=""
if [[ ! -z $1 ]] ; then
sku="$1"
json="$itemdatapath/$1/$1.json"
else
sku="`currentdir`"
json="$currentitempath/`currentdir`.json"
fi
if [[ "`jj -i $json title`" == "`jj -i $json sku`" ]] ; then
if [[ "$sku" == "`jj -i $json title`" ]] ; then
echo No title available for $sku. Skipping. > /dev/null
else
jj -i $json -o $json -v "`tgwtitle $sku`" title && echo $sku title updated to `jj -i $json title`
fi
elif [[ -z "`jj -i $json title`" ]] ; then
if [[ -z "`tgwtitle $sku`" ]] ; then
echo No title available for $sku. Skipping.  > /dev/null
else
jj -i $json -o $json -v "`tgwtitle $sku`" title && echo $sku title updated to `jj -i $json title`
fi
fi
}

fixtitle () {
#If title is empty or matches sku/upc/isbn then fix
sku=""
if [[ ! -z $1 ]] ; then
sku="$1"
json="$itemdatapath/$1/$1.json"
else
sku="`currentdir`"
json="$currentitempath/`currentdir`.json"
fi
if [[ "`jj -i $json title`" == "`jj -i $json sku`" ]] || [[ "`jj -i $json title`" == "`jj -i $json 'P:ISBN'`" ]] || [[ "`jj -i $json title`" == "`jj -i $json 'P:UPC'`" ]] || [[ "`jj -i $json title`" == "0`jj -i $json 'P:UPC'`" ]] ; then
jj -i $json -o $json -v "`jj -i $json Title`" title && echo $sku title updated to `jj -i $json title`
fi
if [[ "`jj -i $json title`" == "`jj -i $json sku`" ]] ; then
if [[ "$sku" == "`tgwtitle $sku`" ]] ; then
echo No title available for $sku. Skipping. > /dev/null
else
jj -i $json -o $json -v "`tgwtitle $sku`" title && echo $sku title updated to `jj -i $json title`
fi
elif [[ -z "`jj -i $json title`" ]] ; then
if [[ -z "`tgwtitle $sku`" ]] ; then
echo No title available for $sku. Skipping.  > /dev/null
else
jj -i $json -o $json -v "`tgwtitle $sku`" title && echo $sku title updated to `jj -i $json title`
fi
fi
}

fixemptylocation () {
sku=""
if [[ ! -z $1 ]] ; then
sku=$1
json="$itemdatapath/$sku/$sku.json"
else
sku="`currentdir`"
json="$currentitempath/$sku.json"
fi
if [[ -z "`jj -i $json location`" ]] ; then
jj -i $json -o $json -v "`tgw_loc $sku`" location
fi
if [[ -z "`jj -i $json location`" ]] ; then
if [[ ! -z "`jj -i $json m2_description`" ]] ; then
jj -i $json -o $json -v "`cat $json | jj m2_description | sed 's/^[^\::=::]*\::=:://' |  sed 's/:.*$//' | sed 's/.* //'`" location
echo $sku moved to `jj -i $json location`
fi
fi
echo $sku is in `jj -i $json location`
}


splitsku() {
sku=$1
newsku=`increment_alphanumeric $sku`
cp -R $itemdatapath/$sku $itemdatapath/$newsku
#rename json
mv $itemdatapath/$newsku/$sku.json $itemdatapath/$newsku/$newsku.json
#change sku in json
sed -i s/$sku/$newsku/g $itemdatapath/$newsku/$newsku.json
#open in dolphin split pane
dolphin --new-window --split $itemdatapath/$sku $itemdatapath/$newsku &
#link to new items
mkdraftlink $newsku
}


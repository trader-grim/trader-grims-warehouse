json_cleaner () {
zip -m $itemarchivepath/$1.zip $1/*combined.json
tgwset $1
tgw tgw_all>$1/$1.json.tmp;mv $1/$1.jso.`date +%Y%M%d%s`n.tmp $1/$1.json
tgw tgw_all>>$itemdatapath/ItemData.json
zip -u $itemarchivepath/$1.zip $1/$1.json
}

json_combine () {
#Command Format json_combine sku jsonA (jsonB jsonC ...)
# wildcards are acceptable
# All files must reference the same sku
echo Combining json files
json_sku=$1
shift
for file in $@ ; do
if [[ -w "$file" ]] ; then
echo Fixing $file
#sed -e 's/\\ufeff//g' |
json_fix_format $json_sku $file
else
echo "$file does not exist or isn't writable"
fi
#cat  $itemdatapath/$json_sku/combined.json.tmp $file | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $itemdatapath/$json_sku/combined.json.tmp
for f in $itemdatapath/$json_sku/combined.json.tmp $file; do jq -f ~/bin/filter_empty.jq $f;done | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $itemdatapath/$json_sku/combined.json.tmp
files_combined="$files_combined$file-"
#echo Files Combined: $files_combined
done
#archivedata $json_sku
#for file in $@ ; do
#done
cp $itemdatapath/$json_sku/$json_sku.json $itemdatapath/$json_sku/$json_sku.json.`date +%Y%m%d%s`-bak
zip -umj $itemarchivepath/$json_sku.zip $@
mv $itemdatapath/$json_sku/combined.json.tmp $itemdatapath/$json_sku/$json_sku.json
cp $itemdatapath/$json_sku/$json_sku.json $itemdatapath/$json_sku/$json_sku.json.`date +%Y%m%d%s`-new
zip -d $itemarchivepath/$json_sku.zip $json_sku.json
zip -uj $itemarchivepath/$json_sku.zip $itemdatapath/$json_sku/$json_sku.json
zip -umj $itemarchivepath/$json_sku.zip $itemdatapath/$json_sku/$json_sku.json.*
#archivedata $json_sku
}

restoreitem () {
for sku in $1  ; do
    cd $sku
    unzip -n $itemarchivepath/$sku.zip $sku.json.* *.jpg *.gif *.mp4
    tgw json_combine $sku $sku.json.*
    cd ..
done

}

combine_all_jsons () {
json_backup $1
#sed -e 's/\\ufeff//g' |
#archivedata $1
for json in $itemdatapath/$1/*.json  ;do
	jq -c ".[]" "$json" | jq -r values
done | jq -r -s 'reduce .[] as $item ({}; . * $item)' > $itemdatapath/$1/$1.json
}


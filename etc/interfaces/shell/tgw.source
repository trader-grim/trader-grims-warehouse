tgwtoenv () {
#eval "$(jq -r 'to_entries[] | "export \(.key)=\(.value)"')"
#eval "$(catsearch $1 | jq -r 'to_entries[] | "export _\(.key)=\"\(.value)\""')"
sku=""
eval "$(catsearch $1 | jq -r 'to_entries[] | "if [[ -z $sku ]] ; then $sku=\(.key) ; fi ; echo $sku_\(.key)=\"\(.value)\""')"
#eval "$(catsearch $1 | jq -r 'to_entries[]')"
}

jsontoenv() {
  sku="$1"
  json_file="$itemdatapath/$sku/$sku.json"

  # Check if the JSON file exists
  if [ ! -f "$json_file" ]; then
    echo "Error: JSON file '$json_file' not found."
    return 1
  fi

  # Read the JSON file and create bash variables
  while IFS='=' read -r key value; do
    # Replace spaces with underscores in the key
    key="${key// /_}"

    # Replace # with underscores in the key
    key="${key//#/_}"

    # Remove quotes from the value
    value="${value%\"}"
    value="${value#\"}"

    # Create the bash variable
    export "$key"="$value"
  done < <(jq -r "to_entries|map(\"\(.key)=\(.value|tostring)\")|.[]" "$json_file")
}

update_key_keep_old_value () {
# This function requires variables "key" "value" and "json" to be set in the script before it is executed
local index=0
while jq -e ".${key}${index}" $json >/dev/null 2>&1; do
    index=$((index + 1))
done
jq ".${key}${index} = .${key} | .${key} = \"${value}\"" $json > $tmpdir/tmpfile && mv $tmpdir/tmpfile $json
}


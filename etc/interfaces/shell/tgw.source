tgw_upc () {
sku=$(getsku $1)
jq -r --arg s $sku ' .upc // ."P:UPC" //  ."$sku"[0].upc //  ."$sku"[0] ."P:UPC"' $itemdatapath/$sku/$sku.json

}

tgw_isbn () {
sku=$(getsku $1)
jq -r --arg s $sku ' ."P:ISBN" // .isbn // ."$sku"[0]."P:ISBN" // ."$sku"[0] .isbn' $itemdatapath/$sku/$sku.json
}

tgw_location () {
sku=$(getsku $1)
jq -r --arg s $sku " .location // .Location // .tgw_location // .m1_location // empty" $itemdatapath/$sku/$sku.json
}

tgw_loc () {
if [[ ! -z "$1" ]] ; then
tgwset $1
fi
tgw_location $sku
}

tgw_location_box () {
jq -r --arg s `tgw_sku` " .location_box // empty" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_location_shelf () {
jq -r --arg s `tgw_sku` " .location_shelf // .Location_shelf // empty" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_location_section () {
jq -r --arg s `tgw_sku` " .location_section // .Location_section // empty" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_location_row () {
jq -r --arg s `tgw_sku` " .location_row // .Location_row // empty" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_location_building () {
jq -r --arg s `tgw_sku` " .location_building // .Location_building // empty" $itemdatapath/`tgw_sku`/`tgw_sku`.json
}

tgw_location_complete () {
echo "`tgw_location_building` `tgw_location_row` `tgw_location_section` `tgw_location_shelf` `tgw_location_box` `tgw_location`"
}

tgw_info_popup () {
if [[ ! -z $1 ]] ; then
sku="$(getsku $1)"
echo $sku
else
sku="$(getsku `tgw current_selection`)"
sku="${sku:-`getsku`}"
fi
if [[ -z "$sku" ]] ; then
kdialog --title OpenItemError --msgbox "No sku provided. You must select a sku or an ebay id."
exit
fi
if [[ ! -d $itemdatapath/$sku/ ]] ; then
sku=`getsku $sku`
fi
if [[ ! -d $itemdatapath/$sku/ ]] ; then
echo no sku or incorrect sku
exit
fi
location="`tgw_location $sku`"
title="`tgw_title $sku`"
isbn="`tgw_isbn $sku`"
upc="`tgw_upc $sku`"
ebayid="`tgw ebay_id $sku`"
currentprice="`tgw current_price $sku`"
ebayprice="`tgw ebay_price $sku`"
tgwprice="`tgw tgw_price $sku`"
status=""`jj -i $itemdatapath/$sku/$sku.json "#STATUS"`""
sort-json $itemdatapath/$sku/$sku.json
kdialog  --geometry +1200+270 --title "Info -- $sku" "`jq -S "." $itemdatapath/$sku/$sku.json | tail -n +2 |head -n -1`" --yes-label=Ok --no-label=Images --cancel-label=Edit --yesnocancel "$sku
$title

Status: $status
Location:  $location
eBay ID:  $ebayid
Current Price:  $currentprice
eBay Price:  $ebayprice
Price:  $tgwprice
ISBN:  $isbn
UPC:  $upc
"
case $? in
0) ;;
1) tgwimageview $sku ;;
2) jsonedit $itemdatapath/$sku/$sku.json ;;
esac
}


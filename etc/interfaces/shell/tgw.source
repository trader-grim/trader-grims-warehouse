alias currentsku=currentdir
currentdir () {
basename `readlink $currentitempath`
}
#currentsku () {
#currentdir
#}

tgwset () {
if [ ! -z "$1" ]; then
sku=$(getsku $1)
fi
if [ -d $itemdatapath/$sku ] && [ ! -z $sku ] && [ $itemdatapath/$sku != $itemdatapath ] ||  [ -d $catalogpath/$1 ] ;  then
echo $catalogpath/$1
rm $currentitempath 2>/dev/null
rm $tgwpath/CurrentItem.json 2>/dev/null
rm $tgwpath/CurrentLocation 2>/dev/null
if [ -d $catalogpath/$1 ] ; then
echo $catalogpath/$1
ln -sf $catalogpath/$1 $currentitempath
ln -sf $catalogpath/$(tgw_location) $tgwpath/CurrentLocation

else
ln -sf $itemdatapath/$sku $currentitempath
ln -sf $itemdatapath/$sku/$sku.json $tgwpath/CurrentItem.json
ln -sf $catalogpath/$(tgw_location) $tgwpath/CurrentLocation
fi
else
rm $currentitempath 2>/dev/null
rm $tgwpath/CurrentItem.json 2>/dev/null
rm $tgwpath/CurrentLocation 2>/dev/null
ln -sf $queuepath $currentitempath
ln -sf $catalogpath

#ln -sf $queuepath/*.json $currentitempath/CurrentItem.json
fi



#kdialog --msgbox $sku
#else
#fi
#if [[ -d $itemdatapath/$altsku ]] ; then
#if [[ $sku != $altsku ]] ;then
#kdialog --msgbox $altsku
#tgw tgwset $altsku
#fi
#fi

}

tgwset_last_new_item () {
sku=$1
if [ ! -z $sku ] && [ -d $new_items/$sku ] ;  then
rm $currentitempath 2>/dev/null
rm $tgwpath/CurrentItem.json 2>/dev/null
item="$new_items/$sku"
json=~"$item/$sku.json"
ln -sf "$item" "$currentitempath"
ln -sf "$json" "$tgwpath/CurrentItem.json"
echo "Current Item is set to `currentdir`"
fi
}

tgwset_watch_for_new_items () {
# Define the directory to monitor
directory_to_monitor="$new_items"

# Define the script to execute
script_to_execute="tgwset_last_new_item"

# Monitor the directory for new directories
echo Watching for new items in $directory_to_monitor:
inotifywait -q -m -e create --format '%f' "$directory_to_monitor" | while read new_dir
do
    # Execute the script when a new directory is created
    "$script_to_execute" "$new_dir"
done
}


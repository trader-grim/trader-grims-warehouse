pushd .
if [[ -z $1 ]] ; then
    echo "No location specified"
    echo "Usage: mkebupdate <location>"
    exit
else
#location=$1
#fi
SECONDS=0
ebcatalog=$ebay_import_jobs/`date +%Y%m%d%M`.ebimport.csv
cp $tgw_config/eBay-revise-listings.csv $ebcatalog
#item="$@"
#for locfolder in $location ; do
#echo Location is $location
for location in $@ ; do
locfolder=$catalogpath/$location
echo Processing locfolder $locfolder
echo
#pushd $locfolder
if [[ ! -d $locfolder ]] ; then
        echo Location $locfolder does not exist
#        exit
fi
#ebcatalog=$ebay_import_jobs/$location.ebimport.csv
if [[ -z $(ls -A $locfolder/tgw*) ]] ; then
ls -A $locfolder
echo No items to process
else

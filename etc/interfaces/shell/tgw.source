ebay_description () {
echo "Up for sale is `tgw_title`<p>Please see our photos for more information about the item. If you need more information about the item please send a message. Photos are of the exact item you receiving with the occasional exception of items that have multiple quantity. Please make sure you take a look before you buy.</p><p>We ship quickly and securely with same or next day handling wherever possible. If you have questions about the item or special packaging or shipping requirements please contact us before placing your order.</p><p>`picklist_line`</p><br><br>"
}

ebay_desc () {
echo -e "Up for sale is `tgw_title`\n\nPlease see our photos for more information about the item. Photos are of the exact item you receiving with the occasional exception of items that have multiple quantity. If you need more information about the item please send a message. Please make sure you take a look before you buy.\n\nWe ship quickly and securely with same or next day handling wherever possible. If you have questions about the item or special packaging or shipping requirements please contact us before placing your order.\n\n\n`picklist_line`\n
"
}

ebay_gpt_desc () {
if [[ ! -z "$1" ]] ; then
sku="$1"
sku=$(getsku $1)
else
sku="`tgw_sku`"
fi
if [[ ! -z `jj -i $itemdatapath/$sku/$sku.json gpt_desc` ]] ; then
echo -n "`jj -i $itemdatapath/$sku/$sku.json gpt_desc`

See our photos for more information about the item. If you need more information about the item please send a message. Our photos are of the exact item you receiving with the occasional exception of items that have multiple quantity where they will all be substantially the same. Please make sure you take a look before you buy.

We ship quickly and securely with same day handling wherever possible. If you have questions about the item, have special packaging or shipping requirements, or even if you just want to say hello please contact us and we'll get back to you ASAP.

--Winchester Mystery Kitchen


`picklist_line $sku`
"
else
ebay_desc $sku
fi
}

paste_gpt_desc () {
ebay_gpt_desc | xsel -i -b ; sleep 0.5; xdotool key Ctrl+V
ebay_gpt_desc | wl-copy ; wl-paste
}

add_gpt_desc () {
if [[ ! -z "$1" ]] ; then
sku="$1"
sku=$(getsku $1)
else
sku="`tgw_sku`"
fi
if [ -z "`jj -i $itemdatapath/$sku/$sku.json gpt_desc`" ] ; then
update_gpt_desc $sku
else
echo Skipping $sku
fi
}

update_gpt_desc () {
if [[ ! -z "$1" ]] ; then
sku="$1"
sku=$(getsku $1)
else
sku="`tgw_sku`"
fi
echo Updating gpt_desc of $sku
json_backup $sku
jj  -i $itemdatapath/$sku/$sku.json  -o $itemdatapath/$sku/$sku.json -D gpt_desc
jj  -i $itemdatapath/$sku/$sku.json  -o $itemdatapath/$sku/$sku.json -v "`tgw gpt_desc $sku`" gpt_desc
}



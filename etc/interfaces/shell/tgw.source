mkdraftfile () {
echo mkdraftfile sku name: check $sku
ebaydraftcsv=$csvnumber-ebay_draft_import.csv
cd $ebay_import_jobs/$csvnumber-import_job
for directory in $(ls -d */) ; do
sku="$(basename $directory /)"
tgwset $sku
mkebaydraft
done
}

mkjob () {
#echo mkjob
if [[ -z $(ls -A $newitems) ]] ; then
ls -A $newitems
echo No items to process
else
mkjob_settings
for directory in $(ls -d $new_items/*/) ; do
sku="$(basename $directory /)"
echo sku name check: $sku
if [[ ! -f $new_items/$sku/$sku.json ]]; then
#data2json
#archivenewitems
itemdatabackup $sku
#add_gpt_desc $sku
fi
done
mv2itemdata
mkdraftfile
echo
echo Job $csvnumber finished
if [[ "$@" == "-all" ]] ; then
echo
echo Updating Catalog and Uploading Files
mktgwcats
tgwgdrive
fi
fi
}


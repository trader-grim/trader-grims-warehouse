mkebaydraftimportcsv () {
# Make Ebay Drafts Import CSV
tgw_config=~/.config/item-creation
template_path=$tgw_config/Templates
csvnumber=$(date +%s)
ebaydraftcsv=$csvnumber-ebay_draft_import.csv
if [ -f "$ebaydraftcsv" ] ; then
mv $ebaydraftcsv $ebaydraftcsv.bak
fi
cp $tgw_config/eBay-draft-listing-import.csv $ebaydraftcsv
printf "\n" >> $ebaydraftcsv
}

mkebaydraftimportcsvbuilder () {
echo Begin processing $new_items/$sku
json=$new_items/$sku/$sku.json
template=$tgw_config/template.json #`cat $sku/$sku.json|jq -r ".$sku[].TEMPLATE"`.json
echo json file is $json
#add_gpt_desc $sku
#echo TEMPLATE file is $template
printf Draft, >> $ebaydraftcsv
printf `tgw_sku`, >> $ebaydraftcsv
group=`cat $json|jq -r '.TEMPLATE // .$sku[].TEMPLATE // empty'`
if [[ $group == null ]] ; then group=default;fi
tgwcat=`cat $new_items/$json|jq -r .$sku[].TEMPLATE`
if [[ $tgwcat == null ]] ; then tgwcat=default;fi
ebcat=`ebay_category_1_number`
ebstorecat="`cat $template|jq -r .$group[].ebay_store_category`"
ebship="`cat $template|jq -r .$group[].ebay_shipping_policy`"
cond=`ebay_condition`
description_blurb="`cat $template|jq -r .$group[].description_blurb`"
name="`tgw_title`"
price=`ebay_price`
qty=`ebay_qty`
tested=`cat $template|jq -r ".$group[].tested // empty"`
printf `cat $new_items/$json|jq -r ".$sku[].ebay_category // $ebcat"`, >> $ebaydraftcsv
#printf "`tgw_title`", >> $ebaydraftcsv
printf "`cat $new_items/$json|jq -r ".$sku[].title"`", >> $ebaydraftcsv
#printf `cat $json|jq --arg n "$name" -r ".$sku[].title // $n"`,
#printf `jq --arg d "$name" -r '.[]$sku.title // $d' $json`,
printf "`cat $new_items/$json|jq -r ".$sku[].isbn // empty"`", >> $ebaydraftcsv
printf `cat $new_items/$json|jq -r ".$sku[].price // $price"`, >> $ebaydraftcsv
printf `cat $new_items/$json|jq -r ".$sku[].qty // $qty"`, >> $ebaydraftcsv
printf , >> $ebaydraftcsv
key="`cat $new_items/$json|jq -r .$sku[].condition`"
default="`cat $template|jq -r .$group[].condition`"
printf `jq --arg d "$default" -r '.[] | .[] | .condition // $d' $new_items/$json`, >> $ebaydraftcsv
#printf "`cat $json|jq -r ".$sku[].name // empty"` `cat $json|jq -r ".$sku[].title // empty"` <br> `cat $json|jq -r ".$sku[].description // empty"`<br> `cat $json|jq --arg blurb "$description_blurb" -r ".$sku[].description_blurb" // $blurb` <br> tgw-pl::=::`cat $json|jq -r ".$sku[].location // empty"`:=:`cat $json|jq -r ".$sku[].title // empty"`:=:$sku:=:$ebay_id:=:$sku", >> $ebaydraftcsv
printf "`ebay_description`", >> $ebaydraftcsv
printf FixedPrice, >> $ebaydraftcsv
printf `cat $new_items/$json|jq -r ".$sku[].warehouse_location // 95453"`, >> $ebaydraftcsv
printf "$ebship", >> $ebaydraftcsv
printf `cat $new_items/$json|jq -r ".$sku[].ebay_best_offer // empty"`, >> $ebaydraftcsv
printf "`cat $new_items/$json|jq -r ".$sku[].condition_description // empty"`", >> $ebaydraftcsv
printf "$ebstorecat", >> $ebaydraftcsv
printf "$tested", >> $ebaydraftcsv
printf `cat $$new_items/json|jq -r ".$sku[].location // empty"`, >> $ebaydraftcsv
linenumber=$((linenumber+1))
printf $linenumber >> $ebaydraftcsv
printf "\n" >> $ebaydraftcsv
echo Processing completed for $new_items/$sku
echo ""
}

ebaydraftimport () {
# Make Ebay Drafts Import CSV
tgw_config=~/.config/item-creation
template_path=$tgw_config/Templates
csvnumber=$(date +%s)
ebaydraftcsv=$csvnumber-ebay_draft_import.csv
if [ -f "$ebaydraftcsv" ] ; then
	mv $ebaydraftcsv $ebaydraftcsv.bak
fi
cp $tgw_config/eBay-draft-listing-import.csv $ebaydraftcsv
printf "\n" >> $ebaydraftcsv
for directory in $(ls -d */) ; do
	sku="$(basename $directory /)"
	tgwset $sku
	mkebaydraftimportcsvbuilder
done
}


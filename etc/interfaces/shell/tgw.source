alias oi=openitem
openitem () {
if [[ $1 == -o ]] ; then
    openfile=Y
    shift
else
    openfile=N
fi
    item=${1:-`getsku`}
#echo $item
if [[ -d $itemdatapath/$item ]] ; then
    if [[ $openfile == Y ]] ; then
     $jsoneditor $itemdatapath/$item/$item.json &
    fi
    dolphin $itemdatapath/$item &

elif [[ -d $catalogpath/$item ]] ; then
    if [[ $openfile == Y ]] ; then
     libreoffice --calc $catalogpath/$item/$item.catalog.csv &
    fi
dolphin $catalogpath/$item &
elif [[ ! -d $itemdatapath/$item ]] ; then
item=`getsku $item`
if [[ -d $itemdatapath/$item ]] ; then
dolphin $itemdatapath/$item &
fi
else
echo \"$item\" not found
fi
}

increment_alphanumeric() {
  local var="$1"
  if [[ $var =~ ^([a-zA-Z]+)([0-9]+)$ ]]; then
    local prefix="${BASH_REMATCH[1]}"
    local number="${BASH_REMATCH[2]}"
    number=$((number + 1))
    printf "%s%d\n" "$prefix" "$number"
  else
    echo "Invalid format"
  fi
}


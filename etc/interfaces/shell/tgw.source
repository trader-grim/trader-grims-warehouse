whisper () {
tmpfile=$(mktemp)
whisper_duration=15
whisper_duration_units=s
whisper_timeout=20
konsole -e countdown $whisper_duration$whisper_duration_units &
timeout $whisper_timeout arecord -d $whisper_duration -f cd -t wav "$tmpfile" 2>/dev/null || exit 1
whisper-cli -nt -m /usr/share/whisper/models/ggml-base.bin -f "$tmpfile" --output-txt | wl-copy
rm "$tmpfile"
notify-send "Dictation ready in clipboard"
}

whisper-clip () {
tmpfile=$(mktemp)
whisper_duration=7
whisper_duration_units=s
whisper_timeout=9
konsole -e countdown $whisper_duration$whisper_duration_units &
timeout $whisper_timeout arecord -d $whisper_duration -f cd -t wav "$tmpfile" 2>/dev/null || exit 1
whisper-cli -nt -m /usr/share/whisper/models/ggml-base.bin -f "$tmpfile" --output-txt | wl-copy
rm "$tmpfile"
notify-send "Dictation ready in clipboard"
}

whisper-title () {
tmpfile=$(mktemp)
whisper_duration=16
whisper_duration_units=s
whisper_timeout=20
konsole -e countdown $whisper_duration$whisper_duration_units &
timeout $whisper_timeout arecord -d $whisper_duration -f cd -t wav "$tmpfile" 2>/dev/null || exit 1
whisper-cli -nt -m /usr/share/whisper/models/ggml-base.bin -f "$tmpfile" --output-txt | wl-copy
sleep 0.5
wl-paste |python3 ~/bin/nopunctTitle.py | wl-copy
echo DATA:title=`wl-paste`|wl-copy
rm "$tmpfile"
notify-send "Title Dictation ready in clipboard"
}

whisper-cond () {
tmpfile=$(mktemp)
whisper_duration=20
whisper_duration_units=s
whisper_timeout=30
konsole -e countdown $whisper_duration$whisper_duration_units &
timeout $whisper_timeout arecord -d $whisper_duration -f cd -t wav "$tmpfile" 2>/dev/null || exit 1
whisper-cli -nt -m /usr/share/whisper/models/ggml-base.bin -f "$tmpfile" --output-txt | wl-copy
sleep 0.5
echo DATA:condition_description=`wl-paste  | python3 ~/bin/nopunct.py `| wl-copy
rm "$tmpfile"
notify-send "`wl-paste`"
}


whisper-hint () {
while true; do
    tmpfile=$(mktemp)
    timeout 10 arecord -d 10 -f cd -t wav "$tmpfile" 2>/dev/null || exit 1
    whisper-cli -nt -m /usr/share/whisper/models/ggml-base.bin -f "$tmpfile" --output-txt | wl-copy
    dictation="`wl-paste | tr -s '\n' ' ' `"
    echo $dictation
    if [[ "$dictation" != " [BLANK_AUDIO]" ]] ; then
        echo DATA:hint=`wl-paste`|wl-copy
    fi
    rm "$tmpfile"
    notify-send "Hint Dictation ready in clipboard"
done
}


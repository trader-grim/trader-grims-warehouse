get_weight () {
input=""
#get weight in oz exact (weight) or rounded up for shipping (roundup)
#if [[ ! -z "$scale" ]] then
#scale="\-i $scale"
#fi
#echo Scale $scale
units=""
input="`usbscale`"
#echo Input $input
if [ -z "$input" ] ; then
#echo No USB scale found on this computer.
exit
fi
#echo Input: $input
IFS=' ' read -ra parts <<< "$input"
weight="${parts[0]}"
#echo Weight: $weight
units="${parts[1]}"
if [ "$units" = "lbs" ] ; then
weight=`echo "$weight * 16" | bc`
#echo Weight $weight
elif [ "$units" = "kg" ] ; then
kilograms="$weight"
grams="$(kilograms * 1000)"
#convert to ounces
weight=`echo "$weight * 35.27396195" | bc`
fi
#round up to next ounce
roundup=$(echo "scale=0; ($weight + 0.9999) / 1" | bc)
#convert weight in ounces to pounds and ounces
ounces=${ounces:-$roundup}
pounds=$((ounces / 16))
remaining_ounces=$((ounces % 16))
kilograms=${kilograms:-`echo "$weight * 0.028349523" | bc`}
grams=${grams:-`echo "$weight * 28.349523" | bc`}
#grams=$((ounces * 28.349523))
if [ "$1" = "showall" ] ; then
echo Weight=$weight
echo Roundup=$roundup
echo Pounds=$pounds
echo Ounces=$ounces
echo Kilograms=$kilograms
echo Grams=$grams
echo "$pounds lbs $remaining_ounces oz"
fi
}

weight () {
get_weight $1
#echo $weight
echo "$pounds lbs $remaining_ounces oz"
}

paste_weight () {
get_weight
echo $roundup | xsel -i -b
echo $roundup | wl-paste
}


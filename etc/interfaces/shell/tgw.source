csvmerge () {
file="$1"
logfile="$file.log"
dirItemData=$itemdatapath
tmpname=`date +%N`
exec < "$file"
count=1
read header
#clear
echo Merging $file
echo ""
while IFS="," read -r  line
do
sku=""
echo $header > $tmpdir/$tmpname.csv
echo $line >> $tmpdir/$tmpname.csv
csv-to-json $tmpdir/$tmpname.csv $tmpdir/$tmpname.json
sku=`cat $tmpdir/$tmpname.json|jq -r '.[].sku'`
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[].SKU'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom Label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom Label (SKU)"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom label (SKU)"'`}
fi
#echo Sku is $sku

json_backup $sku
newjson="$itemdatapath/$sku/$sku-`basename $file`.json"
skujson="$itemdatapath/$sku/$sku.json"
if [[ ! -z "$sku" ]]; then
echo $count. $sku : Merging $newjson
mkdir -p $itemdatapath/$sku
mv $tmpdir/$tmpname.json $newjson
count=$((count+1))
rm $tmpdir/$tmpname.csv
json_fix_format $sku $newjson
#cat  $skujson $newjson | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $skujson
for f in $skujson $newjson ; do jq -f ~/bin/filter_empty.jq $f;done | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $skujson
fixtitle $sku
if [[ `basename $file` == eBay-paid-and-shipped-report* ]] ; then
    Quantity="`jj -i $skujson Quantity`"
    qty="`jj -i $skujson qty`"
if [[ "$qty" == "1-1" ]] ; then
qty="1"
fi
    qty=${qty:0}
    qty=$(("$qty"-"$Quantity"))
    jq --arg qty "$qty" '.qty = $qty' $skujson  > $tmpdir/$sku.json ;mv $tmpdir/$sku.json $skujson
if [[ "$qty" < "1" ]] ; then
#    locup sold $sku
     statup sold $sku
fi
fi
if [[ `basename $newjson` == *eBay-Active-Listings-Item-Specifics-* ]] ; then
echo update skujson description
key=Description
value="`ebay_desc $sku` "
json=$skujson
echo $key = $value to $json
jq --arg desc "$value" '.description = $desc' $skujson  > $tmpdir/$sku.json ;mv $tmpdir/$sku.json $skujson
#update_key_keep_old_value

echo add location field to skujson
key=C:Location
value="`tgw_location $sku`"
json=$skujson
echo $key = $value to $json
jq --arg location "$value" '."C:Location" = $location' $skujson  > $tmpdir/$sku.json ;mv $tmpdir/$sku.json $skujson
cp $skujson ~/Downloads/$sku.json.check
#update_key_keep_old_value

#echo convert skujson to csv
#echo this?
jsonToCsv $skujson $skujson.csv
#echo that?
#is this unnecessary, already csv format?

echo add skujson.csv to ebay import file
cat $skujson.csv
echo "`cat $skujson.csv`,`tgw_location $sku`," >>  ~/Downloads/update_location_description_import.csv
sleep 30
#exit

fi

zip -mjq $itemarchivepath/$sku.zip $newjson
fi
done
mv $file $tgwlogpath/csvmerge/`basename $file`.done
}

csvmerge-ebayid () {
file="$1"
logfile="$file.log"
dirItemData=$itemdatapath
tmpname=`date +%N`
exec < "$file"
count=1
read header
#clear
echo Merging $file
echo ""
while IFS="," read -r  line
do
sku=""
echo $header > $tmpdir/$tmpname.csv
echo $line >> $tmpdir/$tmpname.csv
csv-to-json $tmpdir/$tmpname.csv $tmpdir/$tmpname.json
itemid=`cat $tmpdir/$tmpname.json|jq -r '.[].ItemID'`
if [[ "$itemid" == "null"||"" ]] ; then
    itemid=""
    itemid=${itemid:-`cat $tmpdir/$tmpname.json|jq -r '.[]."eBay item ID"'`}
fi
echo $itemid
sku=`getsku $itemid`
echo $sku
if [[ "$sku" == "null"||"" ]] ; then
    sku="missing"
fi
json_backup $sku
newjson="$itemdatapath/$sku/$sku-`basename $file`.json"
skujson="$itemdatapath/$sku/$sku.json"
if [[ ! -z "$sku" ]]; then
echo $count. $sku : Merging $newjson
mkdir -p $itemdatapath/$sku
mv $tmpdir/$tmpname.json $newjson
count=$((count+1))
rm $tmpdir/$tmpname.csv
json_fix_format $sku $newjson
#cat  $skujson $newjson | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $skujson
for f in $skujson $newjson ; do jq -f ~/bin/filter_empty.jq $f;done | iconv -c -f utf-8 -t ascii - |  json --merge | jj -p -o $skujson
fixtitle $sku
if [[ `basename $file` == eBay-paid-and-shipped-report* ]] ; then
    Quantity="`jj -i $skujson Quantity`"
    qty="`jj -i $skujson qty`"
if [[ "$qty" == "1-1" ]] ; then
qty="1"
fi
    qty=${qty:0}
    qty=$(("$qty"-"$Quantity"))
    jq --arg qty "$qty" '.qty = $qty' $skujson  > $tmpdir/$sku.json ;mv $tmpdir/$sku.json $skujson
if [[ "$qty" < "1" ]] ; then
#    locup sold $sku
     statup sold $sku
fi
fi
zip -mjq $itemarchivepath/$sku.zip $newjson
fi
done
mv $file $tgwlogpath/csvmerge/`basename $file`.done
}


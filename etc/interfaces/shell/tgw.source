alias verup=verifiedupdate
verifiedupdate () {
    local value
    value=$(date +%Y%m%d)
    for sku in "$@"; do
        sku=$(echo "$sku" | tr -d '"')
        tgw verifiedupdate "$sku" "$value"
    done
}


ydotool key 29:1 15:1 15:0 29:0
}

replacephotos () {
sleep 1
xdotool key Ctrl+l Ctrl+f
xdotool type "Complete your listing"
xdotool key Tab Tab Tab Return Ctrl+f
xdotool type "Select"
xdotool key Tab Tab Tab Return Return Ctrl+f
xdotool type "Delete all"
xdotool key Tab Tab Tab Return Return
addphotos
}

addphotos-next () {
addphotos
sleep 0.5
ydotool key 29:1 15:1 15:0 29:0
xdotool keydown Ctrl key Tab keyup Ctrl
}

resumedraft () {
xdotool key Ctrl+f
xdotool type "Resume Draft"
xdotool key Return Return Escape
#xdotool key Ctrl+Return
}


#mkjob section

# Make Ebay Drafts Import CSV
mkjob_settings () {
#echo mkjob_settings
template_path=$tgw_config/Templates
csvnumber=$(date +%s)
linenumber=1
ebaydraftcsv=$new_items/$csvnumber-ebay_draft_import.csv
if [ -f "$ebaydraftcsv" ] ; then
mv $ebaydraftcsv $ebaydraftcsv.bak
fi
cp $tgw_config/eBay-draft-listing-import.csv $ebaydraftcsv
printf "\n" >> $ebaydraftcsv
#cat $ebaydraftcsv
}


data2json-old () {
echo "Building $1.json"
result=""
#Data files to Json
paste -sd'\n' $itemdatapath/$1/*.data >$itemdatapath/$1/$1.json.tmp
#remove leading space in title
sed -i 's/= /=/' $itemdatapath/$1/$1.json.tmp
#change TGW format to json
sed -i 's/TEMPLATE:/TEMPLATE=/' $itemdatapath/$1/$1.json.tmp
sed -i 's/DATA://' $itemdatapath/$1/$1.json.tmp
#convert source line format to json
sed -i -e 's/^/"/' $itemdatapath/$1/$1.json.tmp
sed -i 's/=/":"/g' $itemdatapath/$1/$1.json.tmp
sed -e 's/$/",/' -i $itemdatapath/$1/$1.json.tmp
#Images to Json
imagenumber=""
#Images to Json
find $itemdatapath/$1 -iregex '.*\.\(jpg\|gif\|png\|jpeg\|tiff\)$'  |
while IFS= read -r  image; do
imagenumber=$((imagenumber+1))
printf  "\"image_$imagenumber\": \"$(basename $image )\",\n" >> $itemdatapath/$1/$1.json.tmp
done
videonumber=""
#Videos to Json
find $itemdatapath/$1 -iregex '.*\.\(mp4\|\wmv\|avi\|webm\)$'  |
while IFS= read -r  image; do
imagenumber=$((imagenumber+1))
printf  "\"image_$imagenumber\": \"$(basename $image )\"\n" >> $itemdatapath/$1/$1.json.tmp
done
#remove trailing comma
sed -i '$ s/.$//' $itemdatapath/$1/$1.json.tmp
#add beginning and end marks to complete json document
#sed -i '1s/^/{\n/' $itemdatapath/$1/$1.json.tmp
#sed -i '1s/^/\"'$itemdatapath/$1'\":[\n /' $itemdatapath/$1/$1.json.tmp
sed -i '1s/^/{\n/' $itemdatapath/$1/$1.json.tmp
sed -i -e '$a}' $itemdatapath/$1/$1.json.tmp
#sed -i -e '$a]' $itemdatapath/$1/$1.json.tmp
#sed -i -e '$a}' $itemdatapath/$1/$1.json.tmp
if [[ -f $itemdatapath/$1/$1.json ]] ; then
    mv $itemdatapath/$1/$1.json $itemdatapath/$1/$1.json.$(date +%s)
fi
mv $itemdatapath/$1/$1.json.tmp $itemdatapath/$1/$1.json
#echo "$1 Json Processing Completed"
#cat $1/$1.json
}


data2json () {
#echo data2json
#echo "Building $sku.json"
result=""
#Data files to Json
paste -sd'\n' $new_items/$sku/*.data >$new_items/$sku/$sku.json.tmp
#remove leading space in title
sed -i 's/= /=/' $new_items/$sku/$sku.json.tmp
#change TGW format to json
sed -i 's/TEMPLATE:/TEMPLATE=/' $new_items/$sku/$sku.json.tmp
sed -i 's/DATA://' $new_items/$sku/$sku.json.tmp
#convert source line format to json
sed -i -e 's/^/"/' $new_items/$sku/$sku.json.tmp
sed -i 's/=/":"/g' $new_items/$sku/$sku.json.tmp
sed -e 's/$/",/' -i $new_items/$sku/$sku.json.tmp
#Images to Json
imagenumber=""
#Images to Json
find $new_items/$sku -iregex '.*\.\(jpg\|gif\|png\|jpeg\|tiff\)$'  |
while IFS= read -r  image; do
imagenumber=$((imagenumber+1))
printf  "\"image_$imagenumber\": \"$(basename $image )\",\n" >> $new_items/$sku/$sku.json.tmp
done
videonumber=""
#Videos to Json
find $new_items/$sku -iregex '.*\.\(mp4\|\wmv\|avi\|webm\)$'  |
while IFS= read -r  image; do
imagenumber=$((imagenumber+1))
printf  "\"image_$imagenumber\": \"$(basename $image )\"\n" >> $sku/$sku.json.tmp
done
#remove trailing comma
sed -i '$ s/.$//' $new_items/$sku/$sku.json.tmp
#add beginning and end marks to complete json document
#sed -i '1s/^/{\n/' $new_items/$sku/$sku.json.tmp
#sed -i '1s/^/\"'$sku'\":[\n /' $new_items/$sku/$sku.json.tmp
sed -i '1s/^/{\n/' $new_items/$sku/$sku.json.tmp
sed -i -e '$a}' $new_items/$sku/$sku.json.tmp
#sed -i -e '$a]' $new_items/$sku/$sku.json.tmp
#sed -i -e '$a}' $new_items/$sku/$sku.json.tmp
if [[ -f $new_items/$sku/$sku.json ]] ; then
    mv $new_items/$sku/$sku.json $new_items/$sku/$sku.json.$(date +%s)
fi
mv $new_items/$sku/$sku.json.tmp $new_items/$sku/$sku.json
}

archivenewitems () {
#echo archivedata
echo Archiving Data for $new_items/$sku
zip -qqumj $itemarchivepath/$sku.zip $new_items/$sku/*.json.* $new_items/$sku/*.json $new_items/$sku/*.data $new_items/$sku/.bak $new_items/$sku/*data.txt $new_items/$sku/desktop.ini $new_items/$sku/.picasa.ini $new_items/$sku/.st*
unzip -qq $itemarchivepath/$sku.zip $sku.json -d $new_items/$sku
#unzip -qq $new_items/$sku/$sku.zip $sku-data_combined.json -d $new_items/$sku
}

mv2itemdata () {
#echo mv2itemdata
mkdir $ebay_import_jobs/$csvnumber-import_job
mv $ebaydraftcsv $ebay_import_jobs/$csvnumber-import_job
for item in  $mkjobpath/tgw*  ; do
    name=$(basename $item)
    if [[ ! -d $itemdatapath/$name ]] ; then
        echo moving $item to $itemdatapath
        mv $item $itemdatapath/
        verified="`date +%Y%m%d`"
        tmp="`jq --arg verified "$verified" -r '."#VERIFIED" = $verified' $itemdatapath/$name/$name.json`"
        qty="`echo $tmp|jq -r ".qty // 1"`"
        tmp="`echo $tmp|jq --arg qty "$qty" -r '.qty = $qty'`"
#        echo $tmp > $itemdatapath/$name/$name.json
        cat $itemdatapath/$name/$name.json
    else
        rm $item
    fi
    ln -s $itemdatapath/$name $ebay_import_jobs/$csvnumber-import_job/$name
done
}

mkebaydraft () {
#echo mkebaydraft
echo Begin processing $sku
echo Creating $ebaydraftcsv
json=$sku/$sku.json
template=$tgw_config/template.json #`cat $sku/$sku.json|jq -r ".$sku[].TEMPLATE"`.json
echo json file is $json
echo template file is $template
#add_gpt_desc $sku
printf Draft, >> $ebaydraftcsv
printf `cat $json|jq -r ".sku // empty"`, >> $ebaydraftcsv
group=`cat $json|jq -r .TEMPLATE`
echo group $group
if [[ "$group" == null ]] ; then group=default;fi
tgwcat=`cat $json|jq -r .TEMPLATE`
if [[ $tgwcat == null ]] ; then tgwcat=default;fi
echo tgwcat is $tgwcat
ebcat=`cat $template|jq -r ".$group[].ebay_category // 156532"`
echo ebcat $ebcat
ebstorecat="`cat $template|jq -r .$group[].ebay_store_category`"
ebship="`cat $template|jq -r .$group[].ebay_shipping_policy`"
cond=`cat $template|jq -r .$group[].condition`
description_blurb="`cat $template|jq -r .$group[].description_blurb`"
name="`cat $json|jq -r .title`"
price=`cat $template|jq -r .$group[].price`
qty=`cat $template|jq -r .$group[].qty`
isbn=`cat $json|jq -r ".isbn // empty"`
upc=`cat $json|jq -r ".upc // empty"`
tested=`cat $template|jq -r ".$group[].tested // empty"`
bundle=`cat $template|jq -r ".$group[].custom_bundle // empty"`
modified=`cat $template|jq -r ".$group[].modified_item // empty"`
language=`cat $template|jq -r ".$group[].language // empty"`
manufacture=`cat $template|jq -r ".$group[].country_of_manufacture // empty"`
printf `cat $json|jq -r ".ebay_category // $ebcat"`, >> $ebaydraftcsv
echo title: `tgw_title`
printf "`tgw_title`", >> $ebaydraftcsv
#printf "`cat $json|jq -r ".title"`", >> $ebaydraftcsv
printf "`cat $json|jq -r ".isbn // empty"`", >> $ebaydraftcsv
printf "`cat $json|jq -r ".upc // empty"`", >> $ebaydraftcsv
printf `cat $json|jq -r ".price // $price"`, >> $ebaydraftcsv
printf `cat $json|jq -r ".qty // 1"`, >> $ebaydraftcsv
printf , >> $ebaydraftcsv
key="`cat $json|jq -r .condition`"
default="`cat $template|jq -r .$group[].condition`"
printf "`jq --arg d "$default" -r '.condition // $d' $json`", >> $ebaydraftcsv
printf "`ebay_description`", >> $ebaydraftcsv
printf FixedPrice, >> $ebaydraftcsv
printf `cat $json|jq -r ".warehouse_location // 95453"`, >> $ebaydraftcsv
printf "$ebship", >> $ebaydraftcsv
printf `cat $json|jq -r ".ebay_best_offer // empty"`, >> $ebaydraftcsv
printf "`cat $json|jq -r ".condition_description // empty"`", >> $ebaydraftcsv
printf "$ebstorecat", >> $ebaydraftcsv
printf "$tested", >> $ebaydraftcsv
printf `cat $json|jq -r ".location // empty"`, >> $ebaydraftcsv
printf "$modified", >> $ebaydraftcsv
printf "$bundle", >> $ebaydraftcsv
printf "$language", >> $ebaydraftcsv
printf "$manufacture", >> $ebaydraftcsv
linenumber=$((linenumber+1))
printf $linenumber >> $ebaydraftcsv
printf "\n" >> $ebaydraftcsv
echo Processing completed for $sku
echo ""
#cat $ebaydraftcsv
}


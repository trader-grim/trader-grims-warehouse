loc2csv () {
file="$1"
dirItemData=$itemdatapath
tmpname=`date +%N`
exec < "$file"
count=1
read header
echo $header,location > $itemdatapath/`basename $file`.locations.csv
while IFS="," read -r  line
do
sku=""
echo $header > $tmpdir/$tmpname.csv
echo $line >> $tmpdir/$tmpname.csv
csv-to-json $tmpdir/$tmpname.csv $tmpdir/$tmpname.json
sku=`cat $tmpdir/$tmpname.json|jq -r '.[].sku'`
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[].SKU'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom Label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."      "'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."      "'`}
fi
echo Got sku $sku
location="`jj -i $itemdatapath/$sku/$sku.json location`"
echo $count. $file sku=$sku
echo $line,$location >> $itemdatapath/`basename $file`.locations.csv
#mkdir -p $dirItemData/$sku
#mv $tmpdir/$tmpname.json $dirItemData/$sku/$sku-`basename $file`.json
#echo "        to $dirItemData/$sku/$sku-`basename $file`.json"
#echo ""
count=$((count+1))
rm $tmpdir/$tmpname.csv
done
mv $file $file.done
}


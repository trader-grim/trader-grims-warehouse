##### Begin Search Fuctions #####

alias current_item=getsku
getsku () {
itemid=${1:-`python3 -c "import os; print(os.path.basename (os.path.realpath('$currentitempath')))"`}
# Convert eBay ID to SKU if necessary
if [[ ! -d $itemdatapath/$itemid ]] ; then
if [[ -z `cat  $catalogpath/searchcatalog.json | jq --arg s "$itemid" '.[] | select(.sku == $s) ' | jj sku` ]] ; then
itemid="`cat  $catalogpath/searchcatalog.json | jq --arg s "$itemid" '.[] | select(.ebayid == $s) ' | jj sku`"
fi
# First-18 prefix fallback: 18-char old-format query matches 20-char new-format SKUs
if [[ -z "$itemid" ]] && [[ -n "$1" ]] && [[ ${#1} -le 18 ]] && [[ "$1" == tgw* ]]; then
    itemid="`cat $catalogpath/searchcatalog.json | jq -r --arg p "${1:0:18}" '.[] | select(.sku != null and (.sku | startswith($p))) | .sku' | head -1`"
fi
fi
echo $itemid
}

alias catsloc=catsearchloc
catsearchloc () {
loc="`echo "$1" | tr '[:upper:]' '[:lower:]'`"
catalog=${catalog:-"$catalogpath/searchcatalog.json"}
cat $catalog | jq --arg l "$loc" '.[] | select(if (.location != null ) then .location | ascii_downcase | startswith ($l) else . end)'
}

alias catsebcat=catsearchebaycategory
catsearchebaycategory () {
loc="`echo "$1" | sed 's/ebay-//g'`"
catalog=${catalog:-"$catalogpath/searchcatalog.json"}
cat $catalog | jq --arg l "$loc" '.[] | select(if (."ebaycat" != null ) then .ebaycat == ($l) else . end)'
}
catsearchlocfull () {
loc="`echo "$1" | tr '[:upper:]' '[:lower:]'`"
catalog=${catalog:-"$catalogpath/tgwcatalog.json"}
cat $catalog | jq --arg l "$loc" '.[] | select(if (.location != null ) then .location | ascii_downcase | startswith ($l) else . end)'
}
alias catstat=catsearchstatus
catsearchstatus () {
sku="`echo "$@" | tr '[:upper:]' '[:lower:]'`"
catalog=${catalog:-"$catalogpath/searchcatalog.json"}
cat  $catalog | jq --arg l "$sku" '.[] | select(if (.status != null) then .status | ascii_downcase | startswith ($l) else . end)'
}

alias catsku=catsearchsku
catsearchsku () {
psku="`getsku $1`"
if [[ ! -z $psku ]] ; then
catalog=${catalog:-"$catalogpath/searchcatalog.json"}
cat  $catalog | jq --arg s "$psku" '.[] | select(if (.sku != null )then .sku | startswith ($s) else . end)'
fi
}

alias catstit=catsearchtitle
catsearchtitle () {
ptitle="`echo "$@" | tr '[:upper:]' '[:lower:]'`"
#echo $ptitle
catalog=${catalog:-"$catalogpath/searchcatalog.json"}
cat  $catalog | jq --arg intitle "$ptitle" '.[] | select(if (.title != null) then .title | ascii_downcase | contains ($intitle) else . end)'
}

alias cats=tgw-browser
tgw-browser.old () {
python3 $tgwpath/bin/tgw-browser.py $@
}

#catsearch is the bash cats
catsearch () {
search="$@"
#catalog="$catalogpath/tgwcatalog.json"
catsearchsku "$search"
catsearchloc "$search"
catsearchtitle "$search"
catsearchstatus "$search"
catsearchebaycategory "$search"
}


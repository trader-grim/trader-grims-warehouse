mkfbimport () {
if [[ -z $1 ]] ; then
    echo "No location specified"
    echo "Usage: mkfbimport <location>"
    exit
else
    location=$1
fi
SECONDS=0
locfolder=$catalogpath/$1
#tmpcat=$tmpdir/ItemCatalog
if [[ ! -d $locfolder ]] ; then
        echo $locfolder does not exist
        exit
fi
fbcatalog=$locfolder/$location.fbimport.csv
echo building new Facebook import file in $locfolder
echo "TITLE,PRICE,CONDITION,DESCRIPTION,AVAILABLE INVENTORY,AVAILABLE FOR LOCAL PICKUP,SHIPPING WEIGHT,SHIPPING PRICE,OFFER FREE SHIPPING" > $fbcatalog
#echo "sku,location,ebay_item,title" > $tmpcat/tgwcatalog.csv
count=80
for line in $locfolder/tgw* ; do
    if [ $count == 80 ] ; then
        printf .
        count=0
    fi
    count=$((count+1))
    path="`basename $line`"
    itempath=$locfolder/$path
    json=$itempath/$path.json
    title="`jj -i $json title`"
    title="${title//,/ }"
    sku="`jj -i $json sku`"
    price="`jj -i $json price|awk '{print int($1+0.5)}'`"
    condition="`jj -i $json Condition`"
    condition=${condition:-USED}
    description="`ebay_description`"
    description="${description//,/ }"
    fbdescription="`fb_desc`"
    fbdescription="${fbdescription//,/ }"
    qty="`jj -i $json qty`"
    ebay_item="`jj -i $json 'Item number'`"
#    echo "$sku,$location,$ebay_item,$title" >> $tmpcat/tgwcatalog.csv
#    mkdir -p $tmpcat/$location
#    if [[ ! -f "$fbcatalog" ]] ; then
#        echo "TITLE,PRICE,CONDITION,DESCRIPTION,AVAILABLE INVENTORY,AVAILABLE FOR LOCAL PICKUP,SHIPPING WEIGHT,SHIPPING PRICE,OFFER FREE SHIPPING" > $tmpcat/$location/$fbcatalog
#    fi
#    image="`jj -i $json image`"
#    image=`basename "$image"`
#    ln -s $itempath $tmpcat/$location/
#    echo "=IMAGE(\"http://i3520.local/ItemData/$sku/$image\")',$location,$sku,$ebay_item,$title" >> $tmpcat/$location/$locationcatalog
if [[ "$qty" -gt "0" ]] ; then
    echo "$title,$price,$condition,$description,$qty,Y,1,5,N" >> $fbcatalog
fi
done
printf "\n"
#csv-to-json $tmpcat/tgwcatalog.csv $tmpcat/tgwcatalog.json
#mv -t $catalogpath/ $tmpdir/tgwcatalog.csv $tmpdir/tgwcatalog.json
#mv $tmpcat $catalogpath
t=$SECONDS
#printf 'elapsed time: %d minutes\n' "$(( t/86400 ))" "$(( t/60 - 1440*(t/86400) ))"
printf 'elapsed time: %d minutes\n' "$(( t/60 - 1440*(t/86400) ))"
printf 'Done!\n'
}

json_backup () {
#echo $itemarchivepath/$1.zip
cp $itemdatapath/$1/$1.json $tmpdir/$1.json.`date +%Y%m%d%H%M%S`
zip -mjq $itemarchivepath/$1.zip $tmpdir/$1.json.*
}

itemdatabackup () {
echo Archiving data for $1
json_backup $1
zip -ujq $itemarchivepath/$1.zip $itemdatapath/$1/$1.json $itemdatapath/$1/*.jpg  $itemdatapath/$1/*.gif  $itemdatapath/$1/*.png  $itemdatapath/$1/*.mp4
}


json_fix_format () {
#Command format: json_fix_format sku json_fileebre
# if json_file is not specified the the default file for that sku will be used
#sku="$1"
#json="$1"
if [[ -z "$2" ]] ; then
json="$itemdatapath/$1/$1.json"
#zip="$itemdatapath/$1/$1.zip"
elif [[ -w "$2" ]] ; then
json="$2"
else
echo "$2 does not exist or isn't writable"
exit
fi
json_remove_empty $json
if [[ "[" == "`head -2 $json | tail -1`" ]] ; then
echo reformatted unnamed array
cp $json $json.original_format
head -n -2 $json.original_format | tail -n+3 > $json
#$cat $json
elif [[ "[" == "`head -1 $json`" ]] ; then
#echo reformatted array only
cp $json $json.original_format
sed -e '2,$!d' -e '$d' $json.original_format > $json
#$cat $json
elif [[ "$1" == "`jj -i $json $1.0.sku`" ]] ; then
echo reformatted array json file
cp $json $json.original_format
jj -i $json -o $json $1.0
elif [[ -z "`cat $json`" ]] ; then
printf {\"sku\":\"$1\"}|jj -v $1 -o $json sku
elif [[ "$1" == "`jj -i $json sku`" ]] ; then
echo json format is correct
else
echo json format for is incorrect and needs fixing. Exiting
echo "$1 $json" >> $tgwpath/items_with_json_file_errors.txt
#exit
fi
zip="$itemarchivepath/$1.zip"
zip 2>/dev/null -mjq $zip $json.original_format
}


research () {
search=$1
shift
for word in $@;do shift;search="$search+$word";done
google-chrome "https://www.google.com/search?q='$search'"
google-chrome "https://www.amazon.com/s/ref=nav_bb_sb?field-keywords=$search"
google-chrome "https://www.ebay.com/sch/i.html?_from=R40&_nkw=$search&_sacat=0&rt=nc&LH_Sold=1&LH_Complete=1"
}


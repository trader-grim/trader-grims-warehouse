automerge () {
#This merges any files of the specified type that are in the users Downloads directory
echo Clear eBay Item Numbers?
if confirm; then
    echo "User chose YES. Executing Item Number Delete..."
clearItemnumber
else
    echo "User chose NO. Skipping Item Number Delete..."
fi
clear
for csv in /home/db/Downloads/eBay-all-active-listings-report*.csv /home/db/Downloads/eBay-edit-price-quantity-template*.csv /home/db/Downloads/*tgwup*csv ; do
if [[ -f $csv ]] ; then
echo Merging $csv
csvmerge $csv
fi
done
for isdntekcsv in /home/db/Downloads/feo_*.csv /home/db/Downloads/fer_*.csv ; do
if [[ -f $isdntekcsv ]] ; then
echo $isdntekcsv
csvmerge-ebayid $isdntekcsv
fi
done
if [[ ! -z /home/db/Downloads/eBay-Active-Listings-Item-Specifics*.xlsx ]] ; then
for xlsx in /home/db/Downloads/eBay-Active-Listings-Item-Specifics*.xlsx ; do
xlsx2csv -n Listings $xlsx | sed  '/^#/d; /^#/d; /^#/d' > $xlsx.csv
csvmerge $xlsx.csv
rm $xlsx
done
fi
#if [[ ! -z ~/Downloads/eBay-edit-price-quantity-template*.csv ]] ; then()
#for csv in ~/Downloads/eBay-edit-price-quantity-template*.csv ; do
#csvmerge $csv
#done
#fi
if [[ ! -z ~/Downloads/eBay-paid-and-shipped-report*.csv ]] ; then
for csv in ~/Downloads/eBay-paid-and-shipped-report*.csv ; do
sed -i -e '1d;3d' -e '/^,*$/q' $csv
sed -i '/^,*$/d' $csv
csvmerge $csv
done
fi
if [ $@ == -all ] ; then
echo
echo Updating Catalog and Uploading Files
mktgwcats
tgwgdrive
#tmux -s sync 'tgwsync'
fi
}

csv2skus () {
file="$1"
dirItemData=~tgw20150221122857307/TGW/ItemData
tmpname=`date +%N`
exec < "$file"
count=1
read header
while IFS="," read -r  line
do
sku=""
echo $header > $tmpdir/$tmpname.csv
echo $line >> $tmpdir/$tmpname.csv
csv-to-json $tmpdir/$tmpname.csv $tmpdir/$tmpname.json
sku=`cat $tmpdir/$tmpname.json|jq -r '.[].sku'`
#echo Gotsku $sku
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[].SKU'`}
fi

if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom Label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom label"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom Label (SKU)"'`}
fi
if [[ "$sku" == "null"||"" ]] ; then
    sku=""
    sku=${sku:-`cat $tmpdir/$tmpname.json|jq -r '.[]."Custom label (SKU)"'`}
fi
echo $count. $file sku=$sku
mkdir -p $dirItemData/$sku
mv $tmpdir/$tmpname.json $dirItemData/$sku/$sku-`basename $file`.json
echo "        to $dirItemData/$sku/$sku-`basename $file`.json"
echo ""
count=$((count+1))
rm $tmpdir/$tmpname.csv
done
mv $file $file.done
}


mkebimport () {
#copied from mkjob
if [[ -z $1 ]] ; then
    echo "No location specified"
    echo "Usage: mkebimport <location>"
    exit
else
    location=$1
fi
SECONDS=0
locfolder=$catalogpath/$1
#tmpcat=$tmpdir/ItemCatalog
if [[ ! -d $locfolder ]] ; then
        echo $locfolder does not exist
        exit
fi
ebcatalog=$locfolder/$location.ebimport.csv

if [[ -z $(ls -A $locfolder/tgw*) ]] ; then
ls -A $locfolder
echo No items to process
else
#mkjob_settings
template_path=$tgw_config/Templates
csvnumber=$(date +%s)
linenumber=1
#ebaydraftcsv=$new_items/$csvnumber-ebay_draft_import.csv
cp $tgw_config/eBay-draft-listing-import.csv $ebcatalog
printf "\n" >> $ebcatalog

for directory in $(ls -d $locfolder/*/) ; do
sku="$(basename $directory /)"
echo sku name check: $sku
ebaydraftcsv=$ebcatalog
cd $locfolder #ebay_import_jobs/$csvnumber-import_job
#for directory in $(ls -d */) ; do
sku="$(basename $directory /)"
tgwset $sku
mkebaydraft
done
echo $ebcatalog finished
fi
}


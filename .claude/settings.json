{
  "worktree": {
    "bgIsolation": "none"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/TGW/src/trader-grims-warehouse/.claude/hooks/flake-guard.py",
            "timeout": 10,
            "statusMessage": "Checking flake-mutation guardrail..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/TGW/src/trader-grims-warehouse/.claude/hooks/worktree-guard.py",
            "timeout": 10,
            "statusMessage": "Checking worktree-isolation guardrail..."
          }
        ]
      },
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/TGW/src/trader-grims-warehouse/.claude/hooks/app-code-guard.py",
            "timeout": 10,
            "statusMessage": "Checking app-code branch-per-task guardrail..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 /opt/TGW/src/trader-grims-warehouse/.claude/hooks/session-start-briefing.py",
            "timeout": 30,
            "statusMessage": "Collecting startup-ritual briefing (inbox/suggestions/plan check)..."
          }
        ]
      }
    ]
  }
}

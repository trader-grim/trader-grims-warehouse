#!/bin/bash
# PP-BACKUP-001 A3 — copy secrets bundle to a TGW-SECRETS USB key
#
# Called by tgw-secrets-usb@<LABEL>.service when a TGW-SECRETS key mounts.
# Usage: tgw-secrets-usb-sync <DRIVE_LABEL>
#   DRIVE_LABEL: partition label, e.g. TGW-SECRETS-A
#   Mount point:  /media/tgw/<DRIVE_LABEL>
#
# Setup (per key):
#   sudo tgw-offline-setup TGW-SECRETS-A /dev/sdX   (formats + wires service)
#   Then use tgw-secrets-usb@TGW-SECRETS-A instead of tgw-offline-sync@...
#   in the mount-unit drop-in (edit /etc/systemd/system/<mount>.mount.d/tgw-sync.conf)
set -euo pipefail

LABEL="${1:?Usage: tgw-secrets-usb-sync <DRIVE_LABEL>}"
MOUNT="/media/tgw/${LABEL}"
LOG=/opt/TGW/var/log/offline-sync.log
BUNDLE_SRC=/opt/TGW/var/local/backups/trader_grims_warehouse/secrets
STAMP="${MOUNT}/.tgw-sync-stamp"

if ! mountpoint -q "$MOUNT"; then
    echo "$(date -Iseconds) ERROR ${LABEL} not mounted at ${MOUNT}" >> "$LOG"
    exit 1
fi

# Detect btrfs subvolume layout (provisioned via tgw-offline-setup) vs flat layout
if [ -d "${MOUNT}/@data" ]; then
    DEST="${MOUNT}/@data/TGW-secrets"
else
    DEST="${MOUNT}/TGW-secrets"
fi
mkdir -p "$DEST"

# Copy all secrets bundles (they're small — KB each).
# Guard: require at least one non-empty bundle to prevent rsync --delete from
# wiping the USB key if the source is empty or a bundle write was interrupted.
if find "${BUNDLE_SRC}" -name 'secrets-*.tar.gz.gpg' -size +0c -print -quit 2>/dev/null \
        | grep -q .; then
    rsync -a --delete "${BUNDLE_SRC}/" "$DEST/"
    echo "$(date -Iseconds) ok label=${LABEL} bundles=$(ls "$DEST"/*.gpg 2>/dev/null | wc -l)" >> "$LOG"
else
    echo "$(date -Iseconds) WARN ${LABEL} no secrets bundles found — run tgw-secrets-backup first" >> "$LOG"
    exit 1
fi

date -Iseconds > "$STAMP"
sync

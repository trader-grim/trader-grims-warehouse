#!/bin/bash
# PP-BACKUP-001 A3 — copy secrets bundle to a TGW-SECRETS USB key
#
# SUPERSEDED on NixOS by Syncthing (nix/tgw/usb-sync.nix): Syncthing's
# markerName mechanism auto-syncs the install bundle when LABEL=TGW-SECRETS
# USBs are mounted.  This script remains for interim MX host use only.
#
# Called by tgw-secrets-usb@TGW-SECRETS.service when the drive mounts, or
# directly from tgw-secrets-backup when the USB is already present.
#
# Both rotation USB drives share LABEL=TGW-SECRETS. The UUID logged per sync
# identifies which physical drive received this copy (rotation tracking).
# Log: /opt/TGW/var/log/secrets-rotation.log
#
# Usage: tgw-secrets-usb-sync [LABEL]
#   LABEL defaults to TGW-SECRETS
set -euo pipefail

LABEL="${1:-TGW-SECRETS}"
MOUNT="/media/db/${LABEL}"
BUNDLE_SRC=/opt/TGW/var/local/backups/trader_grims_warehouse/secrets
IDENTITY_AGE=/opt/TGW/secrets/backup-age-identity.age
LOG=/opt/TGW/var/log/secrets-backup.log
ROTATION_LOG=/opt/TGW/var/log/secrets-rotation.log

if ! mountpoint -q "$MOUNT"; then
    echo "$(date -Iseconds) ERROR ${LABEL} not mounted at ${MOUNT}" >> "$LOG"
    exit 1
fi

# UUID identifies which physical drive (A or B) received this copy.
DRIVE_UUID=$(findmnt -n -o UUID "$MOUNT" 2>/dev/null || echo "unknown")

DEST="${MOUNT}/secrets"
mkdir -p "$DEST"

# Guard: require at least one non-empty bundle before syncing.
if ! find "${BUNDLE_SRC}" -name 'secrets-*.tar.gz.age' -size +0c -print -quit 2>/dev/null \
        | grep -q .; then
    echo "$(date -Iseconds) WARN ${LABEL} no secrets bundles found — run tgw-secrets-backup first" >> "$LOG"
    exit 1
fi

rsync -a --delete "${BUNDLE_SRC}/" "$DEST/"

# Copy the passphrase-locked identity alongside the bundle so a bare-metal restore
# only needs this USB + the passphrase (written in safe/wallet).
if [[ -f "$IDENTITY_AGE" ]]; then
    cp "$IDENTITY_AGE" "${MOUNT}/backup-age-identity.age"
fi

BUNDLE_COUNT=$(find "$DEST" -name 'secrets-*.tar.gz.age' 2>/dev/null | wc -l)
echo "$(date -Iseconds) ok label=${LABEL} uuid=${DRIVE_UUID} bundles=${BUNDLE_COUNT}" >> "$LOG"
echo "$(date -Iseconds) uuid=${DRIVE_UUID} label=${LABEL} bundles=${BUNDLE_COUNT}" >> "$ROTATION_LOG"

date -Iseconds > "${MOUNT}/.tgw-sync-stamp"
sync

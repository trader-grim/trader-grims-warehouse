#!/bin/bash
# PP-BACKUP-001 A3 — one-time age keypair generation for secrets bundle encryption
#
# Run once as tgw user:  sudo -u tgw tgw-secrets-keygen
# Idempotent: prints existing public key if identity already exists.
#
# AFTER KEYGEN — create the passphrase-locked restore copy (required):
#   age -p -o /opt/TGW/secrets/backup-age-identity.age \
#           /opt/TGW/secrets/backup-age-identity.txt
#   Write the passphrase on paper — store in safe/wallet.
#   This file is included in every bundle; bare-metal restore needs
#   it + the passphrase + any bundle to reconstruct secrets.
set -euo pipefail

IDENTITY=/opt/TGW/secrets/backup-age-identity.txt

if [[ $EUID -eq 0 ]]; then
    echo "ERROR: run as tgw user, not root — sudo -u tgw tgw-secrets-keygen" >&2
    exit 1
fi

if [[ -f "$IDENTITY" ]]; then
    echo "Identity already exists at $IDENTITY"
    echo "Public key: $(age-keygen -y "$IDENTITY")"
    exit 0
fi

age-keygen -o "$IDENTITY"
chmod 600 "$IDENTITY"

echo ""
echo "Age identity generated: $IDENTITY"
echo "Public key: $(age-keygen -y "$IDENTITY")"
echo ""
echo "Next steps:"
echo "  1. Create passphrase-locked restore copy:"
echo "     age -p -o /opt/TGW/secrets/backup-age-identity.age $IDENTITY"
echo "     Write the passphrase on paper — store in safe or wallet."
echo "  2. Run: tgw-secrets-backup  (creates first bundle)"
echo "  3. Prep USBs: sudo tgw-secrets-usb-prep /dev/sdX  (both rotation drives)"

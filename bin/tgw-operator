#!/bin/sh
set -eu

if [ "$(/usr/bin/id -u)" -eq 0 ]; then
    echo "tgw: privileged execution through the mutable coding runtime is disabled" >&2
    _h=$(/usr/bin/git -C /opt/TGW/tgw-lib/src/trader-grims-warehouse rev-parse HEAD 2>/dev/null || echo '<HEAD>')
    echo "  privileged check:  sudo /usr/local/sbin/tgw-coding-bootstrap --commit $_h" >&2
    echo "  privileged repair: sudo /usr/local/sbin/tgw-coding-bootstrap --commit $_h --repair <op>" >&2
    exit 126
fi

case "${1-}" in
    --help|-h|help|"")
        cat <<'EOF'
Usage: tgw COMMAND [ARGS]

Local tgw-lib controls (ordinary tgw-coders users):
  todo      list and mutate the local Todo store
  coding    start and inspect local coding work
  doctor    diagnose local TGW runtime state
  plan      render and inspect the local Plan taskboard

Run "tgw COMMAND --help" for command help. Other commands are explicitly
delegated to /usr/local/libexec/tgw-production-client.
EOF
        exit 0
        ;;
    todo)
        shift
        exec /opt/TGW/tgw-lib/bin/tgw-todo "$@"
        ;;
    coding)
        shift
        exec /opt/TGW/tgw-lib/bin/tgw-coding "$@"
        ;;
    doctor)
        shift
        exec /opt/TGW/tgw-lib/bin/tgw-doctor "$@"
        ;;
    plan)
        shift
        exec /opt/TGW/tgw-lib/coding-runtime/current/bin/tgw-plan-local-operator "$@"
        ;;
esac

exec /usr/local/libexec/tgw-production-client "$@"

#!/bin/bash
# PP-BACKUP-001 A7 — offline sentry drive sync
#
# Called by tgw-offline-sync@<LABEL>.service when a labeled USB drive mounts.
# Usage: tgw-offline-sync <DRIVE_LABEL>
#   DRIVE_LABEL: partition label, e.g. TGW-SENTRY-01
#   Mount point:  /media/tgw/<DRIVE_LABEL>
#
# Operator setup — for each sentry drive:
#   1. Format and label:  mkfs.ext4 -L TGW-SENTRY-01 /dev/sdX1
#   2. Create mount dir:  mkdir -p /media/tgw/TGW-SENTRY-01
#   3. Add /etc/fstab:    LABEL=TGW-SENTRY-01 /media/tgw/TGW-SENTRY-01 ext4 noauto,user,relatime 0 2
#   4. Wire the trigger:  see etc/systemd/tgw-offline-sync@.service comments
#   Done when: inserting a labeled drive produces a logged, stamped sync twice.
set -euo pipefail

LABEL="${1:?Usage: tgw-offline-sync <DRIVE_LABEL>}"
MOUNT="/media/tgw/${LABEL}"
LOG=/opt/TGW/var/log/offline-sync.log
STAMP="${MOUNT}/.tgw-sync-stamp"

if ! mountpoint -q "$MOUNT"; then
    echo "$(date -Iseconds) ERROR ${LABEL} not mounted at ${MOUNT}" >> "$LOG"
    exit 1
fi

DEST="${MOUNT}/TGW"
mkdir -p "$DEST"

rsync -a --delete \
    /opt/TGW/data/ItemData/ "$DEST/ItemData/"

rsync -a --delete \
    /opt/TGW/var/backups/trader_grims_warehouse/db/ "$DEST/db/"

if ls /opt/TGW/var/local/backups/trader_grims_warehouse/secrets/secrets-*.tar.gz.gpg 2>/dev/null | head -1 | grep -q .; then
    rsync -a \
        /opt/TGW/var/local/backups/trader_grims_warehouse/secrets/ "$DEST/secrets/"
fi

rsync -a --delete \
    /opt/TGW/config/ "$DEST/config/"

date -Iseconds > "$STAMP"
sync

echo "$(date -Iseconds) ok label=${LABEL} dest=${DEST}" >> "$LOG"

#!/bin/bash
# PP-BACKUP-001 A7 — offline sentry/archive drive sync
#
# Called by tgw-offline-sync@<LABEL>.service when a labeled drive mounts.
# Usage: tgw-offline-sync <DRIVE_LABEL>
#   DRIVE_LABEL: partition label, e.g. TGW-OFFLINE-A or TGW-SENTRY-01
#   Mount point:  /media/tgw/<DRIVE_LABEL>
#
# btrfs layout (new drives via tgw-offline-setup):
#   @data/       ← live sync target (subvolume)
#   @snapshots/  ← read-only post-sync snapshots (subvolume, auto-pruned)
# Legacy flat layout (ext4 or unstructured btrfs) also supported.
#
# Drive setup: sudo bin/tgw-offline-setup <LABEL> <DEVICE>
set -euo pipefail

LABEL="${1:?Usage: tgw-offline-sync <DRIVE_LABEL>}"
MOUNT="${TGW_OFFLINE_MOUNT_BASE:-/media/tgw}/${LABEL}"
LOG="${TGW_OFFLINE_LOG:-/opt/TGW/var/log/offline-sync.log}"
SNAPSHOT_KEEP=8  # keep last N snapshots per drive

if ! mountpoint -q "$MOUNT"; then
    echo "$(date -Iseconds) ERROR ${LABEL} not mounted at ${MOUNT}" >> "$LOG"
    exit 1
fi

# Detect btrfs subvolume layout vs legacy flat layout
# STAMP goes inside @data so it is captured by btrfs snapshots; at mount root otherwise.
if [ -d "${MOUNT}/@data" ]; then
    DEST="${MOUNT}/@data/TGW"
    STAMP="${MOUNT}/@data/.tgw-sync-stamp"
    USE_BTRFS_SNAPSHOTS=1
else
    DEST="${MOUNT}/TGW"
    STAMP="${MOUNT}/.tgw-sync-stamp"
    USE_BTRFS_SNAPSHOTS=0
fi

mkdir -p "$DEST"

rsync -a --delete \
    /opt/TGW/data/ItemData/ "$DEST/ItemData/"

rsync -a --delete \
    /opt/TGW/var/backups/trader_grims_warehouse/db/ "$DEST/db/"

if ls /opt/TGW/var/local/backups/trader_grims_warehouse/secrets/secrets-*.tar.gz.gpg \
       2>/dev/null | head -1 | grep -q .; then
    rsync -a \
        /opt/TGW/var/local/backups/trader_grims_warehouse/secrets/ "$DEST/secrets/"
fi

rsync -a --delete \
    /opt/TGW/config/ "$DEST/config/"

date -Iseconds > "$STAMP"
sync

if [ "$USE_BTRFS_SNAPSHOTS" = "1" ]; then
    SNAP_DIR="${MOUNT}/@snapshots"
    SNAP_NAME="$(date +%Y-%m-%dT%H%M)"
    btrfs subvolume snapshot -r "${MOUNT}/@data" "${SNAP_DIR}/${SNAP_NAME}" \
        >> "$LOG" 2>&1
    # Prune: delete oldest snapshots beyond the keep limit
    ls -1dt "${SNAP_DIR}"/*/  2>/dev/null \
        | sed 's|/$||' \
        | tail -n "+$((SNAPSHOT_KEEP + 1))" \
        | while read -r old; do
            btrfs subvolume delete "$old" >> "$LOG" 2>&1
        done
fi

echo "$(date -Iseconds) ok label=${LABEL} dest=${DEST}" >> "$LOG"

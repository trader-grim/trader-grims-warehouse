#!/bin/sh
set -eu

# Runs the live editable source: the controller venv carries an
# __editable__.trader_grims_warehouse .pth pointing at src/. `tgw coding start`
# drives the continual-harness orchestrator; nothing materializes a release tree
# in the completion path (LEAF-11-1.DELETE-APPARATUS).
python=/opt/TGW/.venvs/controller/bin/python3

export PYTHONDONTWRITEBYTECODE=1
exec "$python" -m tgw.coding_cli "$@"

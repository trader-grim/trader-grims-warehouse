#!/bin/bash
# PP-BACKUP-001 A3 — prepare a USB drive as TGW-SECRETS carrier
#
# Both rotation USB drives get the same LABEL=TGW-SECRETS. The UUID logged
# per sync identifies which physical drive was used (rotation tracking).
#
# Usage (as root):
#   tgw-secrets-usb-prep /dev/sdX             # dedicated drive: wipe + format
#   tgw-secrets-usb-prep /dev/sdX add-part    # Ventoy USB: add partition at end
#
# Dedicated drive (1 GB secrets USBs):
#   sudo tgw-secrets-usb-prep /dev/sdX
#
# Ventoy boot USB (4/8 GB, add TGW-SECRETS at the end of sdh):
#   sudo tgw-secrets-usb-prep /dev/sdh add-part
#
# After running, test:
#   mount /media/db/TGW-SECRETS
#   journalctl -u tgw-secrets-usb@TGW-SECRETS -f
#   umount /media/db/TGW-SECRETS
set -euo pipefail

DEVICE="${1:?Usage: tgw-secrets-usb-prep <DEVICE> [add-part]}"
MODE="${2:-}"
LABEL="TGW-SECRETS"
MOUNT="/media/db/${LABEL}"

if [[ $EUID -ne 0 ]]; then
    echo "ERROR: run as root — sudo tgw-secrets-usb-prep $*" >&2
    exit 1
fi

if [[ ! -b "$DEVICE" ]]; then
    echo "ERROR: $DEVICE is not a block device" >&2
    exit 1
fi

if [[ "$MODE" == "add-part" ]]; then
    # Add TGW-SECRETS partition in the remaining free space at the end of a Ventoy USB.
    # Ventoy layout: p1 = ventoy (ISO storage), p2 = VTOYEFI; new p3 = TGW-SECRETS.
    echo "==> Adding TGW-SECRETS partition at end of $DEVICE ..."
    EXISTING=$(blkid -s LABEL -o value "${DEVICE}1" 2>/dev/null || true)
    if [[ "${EXISTING,,}" != "ventoy" ]]; then
        echo "WARNING: expected partition 1 to be labeled 'Ventoy', got: ${EXISTING:-none}"
        read -rp "Continue anyway? [yes/N] " CONFIRM
        [[ "$CONFIRM" == "yes" ]] || { echo "Aborted."; exit 1; }
    fi

    # Find where the last partition ends (in MiB) to start the new one.
    LAST_END=$(parted -ms "$DEVICE" unit MiB print 2>/dev/null \
        | awk -F: 'NR>2 && /^[0-9]/ {gsub(/MiB/,""); last=$3} END {print int(last)+1}')
    if [[ -z "$LAST_END" || "$LAST_END" -lt 10 ]]; then
        echo "ERROR: could not determine last partition end on $DEVICE" >&2
        exit 1
    fi
    echo "    Last partition ends at ~${LAST_END} MiB; creating TGW-SECRETS from ${LAST_END}MiB to 100%"

    parted -s "$DEVICE" mkpart primary ext4 "${LAST_END}MiB" 100%
    sleep 1
    partprobe "$DEVICE"
    sleep 1

    # Identify the newly created partition (last one listed by lsblk)
    NEW_PART=$(lsblk -ln -o NAME "$DEVICE" | grep -v "^$(basename "$DEVICE")$" | tail -n1)
    NEW_DEV="/dev/${NEW_PART}"

    if [[ ! -b "$NEW_DEV" ]]; then
        echo "ERROR: new partition $NEW_DEV not found after partprobe" >&2
        exit 1
    fi

    mkfs.ext4 -L "$LABEL" "$NEW_DEV"
    NEW_UUID=$(blkid -s UUID -o value "$NEW_DEV")
    echo "==> Partition created: $NEW_DEV  uuid=${NEW_UUID}"

else
    # Dedicated drive: GPT + single ext4 partition covering the whole drive.
    EXISTING_PT=$(parted -ms "$DEVICE" print 2>/dev/null | awk -F: 'NR==2 {print $6}' || true)
    EXISTING_FS=$(blkid -s TYPE -o value "$DEVICE" 2>/dev/null || true)
    if [[ -n "$EXISTING_PT" || -n "$EXISTING_FS" ]]; then
        echo "WARNING: $DEVICE already has content"
        echo "         partition table: ${EXISTING_PT:-none}  filesystem: ${EXISTING_FS:-none}"
        read -rp "Destroy ALL data on $DEVICE and create GPT + ext4 TGW-SECRETS? [yes/N] " CONFIRM
        [[ "$CONFIRM" == "yes" ]] || { echo "Aborted."; exit 1; }
    fi
    echo "==> Creating GPT partition table on $DEVICE ..."
    parted -s "$DEVICE" mklabel gpt
    parted -s "$DEVICE" mkpart primary ext4 1MiB 100%
    parted -s "$DEVICE" name 1 "$LABEL"
    sleep 1
    partprobe "$DEVICE"
    sleep 1
    NEW_DEV="${DEVICE}1"
    echo "==> Formatting ${NEW_DEV} as ext4, label=${LABEL} ..."
    mkfs.ext4 -L "$LABEL" "$NEW_DEV"
    NEW_UUID=$(blkid -s UUID -o value "$NEW_DEV")
    echo "==> Drive formatted: $NEW_DEV  uuid=${NEW_UUID}"
    # Set filesystem root ownership to tgw so the sync service can write without root.
    TMPMNT=$(mktemp -d)
    mount "$NEW_DEV" "$TMPMNT"
    # Ownership: db:users — Syncthing runs as db on NixOS (nix/os/base.nix)
    chown db:users "$TMPMNT"
    # Syncthing markerName sentinel — must exist at the filesystem root.
    # Syncthing pauses the tgw-usb-bundle folder when this file is absent
    # (i.e. when the USB is not plugged in), preventing sync to an empty path.
    touch "${TMPMNT}/.tgw-bundle"
    chown db:users "${TMPMNT}/.tgw-bundle"
    umount "$TMPMNT"
    rmdir "$TMPMNT"
    echo "    Filesystem root: chowned to db:users, .tgw-bundle marker created"
fi

echo "==> Creating mount point $MOUNT ..."
mkdir -p "$MOUNT"
chown db:users "$MOUNT"

echo "==> Adding /etc/fstab entry ..."
FSTAB_ENTRY="LABEL=${LABEL}  ${MOUNT}  ext4  noauto,nofail,users  0 0"
if grep -qF "LABEL=${LABEL}" /etc/fstab; then
    echo "    (fstab entry for ${LABEL} already present — skipping)"
else
    printf '\n# TGW secrets USB %s (PP-BACKUP-001 A3)\n%s\n' "$LABEL" "$FSTAB_ENTRY" >> /etc/fstab
    echo "    Added: $FSTAB_ENTRY"
fi

echo "==> Wiring systemd mount-unit drop-in ..."
ESCAPED=$(systemd-escape --path "$MOUNT")
DROPIN_DIR="/etc/systemd/system/${ESCAPED}.mount.d"
mkdir -p "$DROPIN_DIR"
cat > "${DROPIN_DIR}/tgw-sync.conf" <<EOF
[Unit]
Wants=tgw-secrets-usb@${LABEL}.service
EOF
systemctl daemon-reload
echo "    Drop-in: ${DROPIN_DIR}/tgw-sync.conf"

SIZE=$(lsblk -dn -o SIZE "$NEW_DEV" 2>/dev/null || echo "?")
SETUP_DATE=$(date +%Y-%m-%d)

echo ""
echo "==> ${LABEL} carrier ready on ${NEW_DEV} (${SIZE})"
echo ""
echo "  UUID: ${NEW_UUID}  ← record this in the rotation log"
echo "  Mount: ${MOUNT}"
echo ""
echo "  Test sequence:"
echo "    mount ${MOUNT}"
echo "    journalctl -u tgw-secrets-usb@${LABEL} -f"
echo "    umount ${MOUNT}"
echo ""
echo "══════════════════════════════════════════════"
echo "  QR LABEL CONTENT"
echo "══════════════════════════════════════════════"
cat <<QR
${LABEL}
Encrypted secrets bundle (age) — rotate monthly
Format: ext4 | UUID: ${NEW_UUID}
Size: ${SIZE} | Mount: ${MOUNT}
Setup: ${SETUP_DATE}
QR
echo "══════════════════════════════════════════════"

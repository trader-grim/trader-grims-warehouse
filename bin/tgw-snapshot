#!/bin/bash
# PP-BACKUP-001 — hourly btrfs snapshot of /opt/TGW → /home/snapshot/TGW-SNAPSHOT-0
#
# Both source (nvme0n1p3) and target (sda7) are btrfs. Separate partitions
# (data/history, var/local/backups) are naturally excluded as btrfs send does
# not cross filesystem boundaries.
#
# Layout on source (nvme0n1p3):
#   /opt/TGW/.snapshots/YYYYMMDDTHHMM  ← local read-only snapshots (last 2 kept)
#
# Layout on target (sda7, TGW-SNAPSHOT-0):
#   YYYYMMDDTHHMM/  ← received read-only snapshots, pruned to SNAP_KEEP
#
# Runs as root (btrfs subvolume ops require CAP_SYS_ADMIN).
# Installed as: tgw-snapshot.service + tgw-snapshot.timer (hourly)
set -euo pipefail

SRC="/opt/TGW"
SNAP_DIR="/opt/TGW/.snapshots"
SNAP_ROOT="/home/snapshot/TGW-SNAPSHOT-0"
SNAP_KEEP=48
LOCAL_KEEP=2
LOG=/opt/TGW/var/log/tgw-snapshot.log
STAMP="$(date +%Y%m%dT%H%M)"
LOCAL_SNAP="${SNAP_DIR}/${STAMP}"

log() { echo "$(date -Iseconds) $*" >> "$LOG"; }

if ! mountpoint -q "$SNAP_ROOT"; then
    log "ERROR: ${SNAP_ROOT} is not mounted — aborting"
    exit 1
fi

mkdir -p "$SNAP_DIR"

log "start stamp=${STAMP}"

btrfs subvolume snapshot -r "$SRC" "$LOCAL_SNAP" >> "$LOG" 2>&1

PREV="$(ls -1dt "${SNAP_DIR}"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9] 2>/dev/null \
    | grep -v "$LOCAL_SNAP" | head -1)"

if [ -n "$PREV" ]; then
    log "incremental send parent=${PREV##*/}"
    btrfs send -p "$PREV" "$LOCAL_SNAP" | btrfs receive "$SNAP_ROOT/" >> "$LOG" 2>&1
else
    log "full send (no parent)"
    btrfs send "$LOCAL_SNAP" | btrfs receive "$SNAP_ROOT/" >> "$LOG" 2>&1
fi

# Prune old snapshots on target
ls -1dt "${SNAP_ROOT}"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9]/ 2>/dev/null \
    | sed 's|/$||' \
    | tail -n "+$((SNAP_KEEP + 1))" \
    | while read -r old; do
        btrfs subvolume delete "$old" >> "$LOG" 2>&1
        log "pruned target ${old##*/}"
    done

# Prune old local snapshots (keep LOCAL_KEEP for incremental parent)
ls -1dt "${SNAP_DIR}"/[0-9][0-9][0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9] 2>/dev/null \
    | tail -n "+$((LOCAL_KEEP + 1))" \
    | while read -r old; do
        btrfs subvolume delete "$old" >> "$LOG" 2>&1
        log "pruned local ${old##*/}"
    done

log "done stamp=${STAMP}"

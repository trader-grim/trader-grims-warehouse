#!/bin/bash
# PP-BACKUP-001 A3 — encrypted secrets + config bundle (age public-key encryption)
#
# Covers: secrets/ (API keys, OAuth tokens) and config/ (app config, policies).
# Run monthly via tgw-secrets-backup.timer, or manually after any credential change.
#
# FIRST-TIME SETUP (run in order):
#   1. sudo apt install age
#   2. sudo -u tgw tgw-secrets-keygen
#   3. age -p -o /opt/TGW/secrets/backup-age-identity.age \
#               /opt/TGW/secrets/backup-age-identity.txt
#      Write the passphrase on paper — store in safe/wallet.
#   4. Prep both rotation USB drives:
#      sudo tgw-secrets-usb-prep /dev/sdX          (1 GB keychain drive)
#      sudo tgw-secrets-usb-prep /dev/sdY          (1 GB safe drive)
#      sudo tgw-secrets-usb-prep /dev/sdh add-part (Ventoy USB — add TGW-SECRETS at end)
#   5. sudo systemctl enable --now tgw-secrets-backup.timer
#
# MONTHLY ROTATION: plug in one TGW-SECRETS USB, run this script. The UUID of
#   the drive used is logged in secrets-rotation.log so you know which to swap
#   next time. Then swap the drives (keychain ↔ safe).
#
# RESTORE from bare metal:
#   1. Mount TGW-SECRETS USB
#   2. Decrypt identity: age -d -i /dev/stdin backup-age-identity.age > identity.txt
#      (enter passphrase from safe/wallet)
#   3. Decrypt bundle:   age -d -i identity.txt secrets-YYYYMMDD.tar.gz.age | tar -xz
set -euo pipefail

IDENTITY=/opt/TGW/secrets/backup-age-identity.txt
# Moved 2026-07-04 onto a genuinely separate physical drive (/dev/sdc1,
# LABEL=tgw-db-backup) — matches config.py's backup_snapshot_root.
SNAP_DIR=/opt/TGW/mnt/tgw-db-backup/trader_grims_warehouse/secrets
# Fixed 2026-07-18: previously had no --config flag (fell through to the
# tgw user's nonexistent default rclone config) and pointed REMOTE_DEST at
# a 'dbukove:' remote that has never existed in rclone.conf -- this script
# had never successfully run. Caught before its first scheduled fire
# (timer next due 2026-08-01), not after a real failure.
RCLONE_CONF=/opt/TGW/config/rclone.conf
REMOTE_DEST=tgw-gdrive:TGW-secrets
STAMP=$(date +%Y%m%d)
BUNDLE="$SNAP_DIR/secrets-${STAMP}.tar.gz.age"
LOG=/opt/TGW/var/log/secrets-backup.log

mkdir -p "$SNAP_DIR"

if [[ ! -f "$IDENTITY" ]]; then
    echo "ERROR: age identity not found at $IDENTITY" >&2
    echo "  Run: sudo -u tgw tgw-secrets-keygen" >&2
    exit 1
fi

PUBKEY=$(age-keygen -y "$IDENTITY")

# Bundle: secrets/ + config/. backup-age-identity.age is inside secrets/ so it
# is included automatically. A bare-metal restore only needs: bundle + passphrase.
tar -C /opt/TGW -cz secrets config | age -r "$PUBKEY" -o "$BUNDLE"

# Cloud copy
rclone copy "$SNAP_DIR/" "$REMOTE_DEST/" --config "$RCLONE_CONF" --log-level INFO

# Keep 3 most recent bundles on the snapshot disk; cloud retains all.
ls -t "$SNAP_DIR"/secrets-*.tar.gz.age 2>/dev/null | tail -n +4 | xargs -r rm -f

echo "$(date -Iseconds) ok bundle=${BUNDLE}" >> "$LOG"
echo "Bundle: $BUNDLE"
echo "Cloud:  $REMOTE_DEST"

# On MX: if a TGW-SECRETS USB is mounted, sync to it now (interim rsync path).
# On NixOS: Syncthing handles USB distribution automatically (nix/tgw/usb-sync.nix).
MOUNT=/media/db/TGW-SECRETS
if mountpoint -q "$MOUNT" 2>/dev/null; then
    echo "TGW-SECRETS USB detected at $MOUNT — syncing ..."
    /opt/TGW/current/bin/tgw-secrets-usb-sync TGW-SECRETS
fi

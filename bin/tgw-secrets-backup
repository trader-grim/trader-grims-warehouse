#!/bin/bash
# PP-BACKUP-001 A3 — encrypted secrets bundle
#
# Run monthly via tgw-secrets-backup.timer, or manually after any credential change.
#
# PASSPHRASE CUSTODY (operator gate before first use):
#   The GPG symmetric passphrase must exist somewhere that survives the house
#   burning down with the server — written on paper in a safe or wallet.
#   Without it the bundle is useless; with it stored on this disk it is theater.
#   Use at least 2 rotated USB keys (same partition label TGW-SECRETS) so a
#   single corrupt drive is not a total restore failure.
set -euo pipefail

SECRETS_SRC=/opt/TGW/secrets
SNAP_DIR=/opt/TGW/var/local/backups/trader_grims_warehouse/secrets
REMOTE_DEST=dbukove:TGW-secrets
STAMP=$(date +%Y%m%d)
BUNDLE="$SNAP_DIR/secrets-${STAMP}.tar.gz.gpg"
LOG=/opt/TGW/var/log/secrets-backup.log

mkdir -p "$SNAP_DIR"

tar -C /opt/TGW -cz secrets \
    | gpg --symmetric --cipher-algo AES256 --batch -o "$BUNDLE"

rclone copy "$SNAP_DIR/" "$REMOTE_DEST/" --log-level INFO

# Keep 3 most recent bundles on the snapshot disk; cloud retains all.
ls -t "$SNAP_DIR"/secrets-*.tar.gz.gpg 2>/dev/null | tail -n +4 | xargs -r rm -f

echo "$(date -Iseconds) ok bundle=${BUNDLE}" >> "$LOG"

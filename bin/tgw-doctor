#!/bin/sh
set -eu

# Runs the live editable source: the controller venv carries an
# __editable__.trader_grims_warehouse .pth pointing at src/. The tgw-lib
# development loop has no materialized release tree (LEAF-11-1.DELETE-APPARATUS).
python=/opt/TGW/.venvs/controller/bin/python3

export PYTHONDONTWRITEBYTECODE=1
exec "$python" -m tgw.doctor_cli "$@"

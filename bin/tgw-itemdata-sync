#!/usr/bin/env bash
# tgw-itemdata-sync — continuous ItemData → GDrive sync (PP-PHOTO-001)
#
# Runs as a long-lived systemd service (tgw-itemdata-sync.service).
# Syncs /opt/TGW/data/ItemData/ → tgw-gdrive:TGW/data/ItemData/ every
# INTERVAL seconds.  Uses a shared flock so this and tgw-cloud-sync never
# hit Drive in parallel.
#
# Sync status is written atomically to STATUS_FILE at cycle start and end
# so other processes (ebay_draft, PP-PHOTO-001 GDrive URL helper) can tell
# exactly when Drive was last fully consistent with local ItemData.
#
# Status file schema:
#   state        "running" | "idle" | "skipped"
#   cycle        integer, increments each loop iteration
#   started_at   ISO-8601 timestamp when this cycle's rclone began
#   completed_at ISO-8601 timestamp when rclone exited cleanly (null if running/skipped)
#   pid          this process's PID (for watchdog use)
# WATCHDOG (todo #1517, PP-BACKUP-001): same reasoning as tgw-cloud-sync —
# an rclone subprocess that hangs (e.g. after a Google Drive 403) instead
# of exiting would hold this loop's flock for the duration, which would in
# turn block tgw-cloud-sync's own (also-now-bounded) blocking flock wait.
# RCLONE_TIMEOUT_SECS default is well above a normal ~120s cycle but bounds
# any one stuck cycle so the flock is always released within a bounded
# window; overridable via env for testing. See tgw-cloud-sync for the
# fuller writeup of the ceiling choice (judgment call, CLAUDE.md Prime
# Directive 3).
set -uo pipefail

RCLONE_CONF="${TGW_RCLONE_CONF:-/opt/TGW/config/rclone.conf}"
REMOTE=tgw-gdrive:TGW/data/ItemData
LOCAL="${TGW_ITEMDATA_LOCAL:-/opt/TGW/data/ItemData}"
LOG="${TGW_RCLONE_ITEMDATA_LOG:-/opt/TGW/var/log/rclone-itemdata-sync.log}"
STATUS_FILE="${TGW_RCLONE_ITEMDATA_STATUS:-/opt/TGW/var/log/rclone-itemdata-sync-status.json}"
LOCK="${TGW_RCLONE_LOCK:-/run/lock/tgw-rclone-gdrive.lock}"
INTERVAL="${TGW_ITEMDATA_SYNC_INTERVAL:-120}"   # seconds between sync cycles
RCLONE_TIMEOUT_SECS="${RCLONE_TIMEOUT_SECS:-14400}"
RCLONE_KILL_AFTER_SECS="${RCLONE_KILL_AFTER_SECS:-30}"
CYCLE=0

log() { echo "$(date -Iseconds) $*" >> "$LOG"; }

# Atomic status write — temp file + rename so readers never see a partial write
write_status() {
    local state=$1 started=$2 completed=$3
    printf '{"state":"%s","cycle":%d,"started_at":"%s","completed_at":%s,"pid":%d}\n' \
        "$state" "$CYCLE" "$started" "$completed" "$$" \
        > "${STATUS_FILE}.tmp"
    mv -f "${STATUS_FILE}.tmp" "$STATUS_FILE"
}

log "tgw-itemdata-sync started (pid=$$, interval=${INTERVAL}s)"

while true; do
    CYCLE=$(( CYCLE + 1 ))
    STARTED=$(date -Iseconds)

    if flock -n 9; then
        write_status "running" "$STARTED" "null"
        log "cycle $CYCLE started"

        # --tpslimit 2 (todo #1264, Dave 2026-07-10): same known-good value
        # as bin/tgw-cloud-sync / bin/dedupe-gdrive.sh — avoids Drive
        # per-minute quota errors while leaving headroom for a second
        # rclone process running concurrently.
        timeout --kill-after="${RCLONE_KILL_AFTER_SECS}" "${RCLONE_TIMEOUT_SECS}s" rclone sync "$LOCAL" "$REMOTE" \
            --config "$RCLONE_CONF" \
            --log-file "$LOG" \
            --log-level INFO \
            --stats 60s \
            --transfers 4 \
            --checkers 8 \
            --fast-list \
            --use-mmap \
            --tpslimit 2
        rc=$?
        COMPLETED=$(date -Iseconds)
        write_status "idle" "$STARTED" "\"$COMPLETED\""
        if [ "$rc" -eq 0 ]; then
            log "cycle $CYCLE completed at $COMPLETED"
        elif [ "$rc" -eq 124 ] || [ "$rc" -eq 137 ]; then
            log "cycle $CYCLE ERROR: rclone watchdog fired after ${RCLONE_TIMEOUT_SECS}s (hung subprocess killed, lock released) — treat as an incident, not a transient failure."
        else
            log "cycle $CYCLE ERROR: rclone exited with code $rc — see $LOG for detail."
        fi
    else
        write_status "skipped" "$STARTED" "null"
        log "cycle $CYCLE skipped — lock held by another rclone process"
    fi 9>"$LOCK"

    sleep "$INTERVAL"
done

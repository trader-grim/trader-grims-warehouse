#!/usr/bin/env bash
# PP-BACKUP-001 A2 — daily full rclone sync to Google Drive
#
# PRE-STEP (one-time, operator): preserve the frozen 2026-05-14 history point BEFORE
# running this for the first time:
#   rclone --config /opt/TGW/config/rclone.conf copy tgw-gdrive:TGW tgw-gdrive:TGW-historypoint-20260514
# Verify: rclone --config /opt/TGW/config/rclone.conf size tgw-gdrive:TGW-historypoint-20260514
#
# Shares a flock with tgw-itemdata-sync so the two never run concurrently.
set -euo pipefail

RCLONE_CONF=/opt/TGW/config/rclone.conf
REMOTE=tgw-gdrive:TGW
LOG=/opt/TGW/var/log/rclone-sync.log
STAMP_FILE=/opt/TGW/var/log/rclone-sync-last-success
TRASH="tgw-gdrive:TGW-trash/$(date +%Y%m%d)"
LOCK=/run/lock/tgw-rclone-gdrive.lock

# Blocking flock — waits for itemdata-sync to finish its current cycle
exec 9>"$LOCK"
flock 9

rclone sync /opt/TGW "$REMOTE" \
    --config "$RCLONE_CONF" \
    --filter "+ bin/**" \
    --filter "+ config/**" \
    --filter "+ data/**" \
    --filter "+ docs/**" \
    --filter "+ var/log/**" \
    --filter "+ var/backups/trader_grims_warehouse/db/**" \
    --filter "+ src/**" \
    --filter "- **" \
    --backup-dir "$TRASH" \
    --log-file "$LOG" \
    --log-level INFO \
    --fast-list \
    --transfers 4 \
    --checkers 8

date -Iseconds > "$STAMP_FILE"

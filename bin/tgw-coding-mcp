#!/bin/sh
set -eu

# Runs the live editable source (controller venv .pth); no materialized
# release tree in the tgw-lib path (LEAF-11-1.DELETE-APPARATUS).
python=/opt/TGW/.venvs/controller/bin/python3

export PYTHONDONTWRITEBYTECODE=1
export TGW_CODING_CONFIG=/opt/TGW/tgw-lib/config/tgw-coding-local.json
exec "$python" -m tgw.coding_mcp_server

[Unit]
Description=TGW local independent diagnostic review worker
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/TGW/tgw-lib/config/tgw-coding-local.json
ConditionPathExists=/opt/TGW/tgw-lib/coding-runtime/current/src/tgw/development/local_workflow.py
ConditionPathExists=/var/lib/tgw/coding-protected-review/config.json
ConditionPathIsDirectory=/var/lib/tgw/coding-protected-review/requests
ConditionPathExists=/var/lib/tgw/coding-protected-review/credentials/context.json
ConditionPathExists=/var/lib/tgw/coding-protected-review/credentials/evidence.json

[Service]
Type=simple
User=codex
Group=tgw-coders
SupplementaryGroups=tgw-coders
UMask=0002
WorkingDirectory=/opt/TGW/tgw-lib/src/trader-grims-warehouse
Environment=HOME=/home/codex
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=PYTHONPATH=/opt/TGW/tgw-lib/coding-runtime/current/src
LoadCredential=review-context:/var/lib/tgw/coding-protected-review/credentials/context.json
LoadCredential=review-evidence:/var/lib/tgw/coding-protected-review/credentials/evidence.json
Environment=TGW_REVIEW_CONTEXT_CREDENTIAL_FILE=%d/review-context
Environment=TGW_REVIEW_EVIDENCE_CREDENTIAL_FILE=%d/review-evidence
ExecStart=/opt/TGW/.venvs/controller/bin/python3 -m tgw.development.local_workflow --config /opt/TGW/tgw-lib/config/tgw-coding-local.json worker --queue claude-review
Restart=on-failure
RestartSec=5s
TimeoutStopSec=1900s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

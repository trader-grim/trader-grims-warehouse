[Unit]
Description=TGW local coding runtime materializer (ordinary Unix account)
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/TGW/tgw-lib/config/tgw-coding-local.json
ConditionPathExists=/opt/TGW/tgw-lib/coding-runtime/current/src/tgw/development/coding_root_effect.py

[Service]
Type=simple
User=db
Group=tgw-coders
SupplementaryGroups=tgw-coders
UMask=0002
WorkingDirectory=/opt/TGW/tgw-lib/coding-runtime/current
Environment=HOME=/home/db
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=PYTHONPATH=src
ExecStart=/opt/TGW/.venvs/controller/bin/python3 -m tgw.development.coding_root_effect --config /opt/TGW/tgw-lib/config/tgw-coding-local.json
Restart=always
RestartSec=5s
PrivateTmp=true
ProtectHome=read-only

[Install]
WantedBy=multi-user.target

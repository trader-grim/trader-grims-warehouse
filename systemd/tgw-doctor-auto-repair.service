[Unit]
Description=TGW bounded Doctor auto-repair supervisor
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/TGW/tgw-lib/config/tgw-coding-local.json

[Service]
Type=oneshot
User=db
Group=db
SupplementaryGroups=tgw-coders
UMask=0002
WorkingDirectory=/opt/TGW/tgw-lib/src/trader-grims-warehouse
Environment=HOME=/home/db
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=PYTHONPATH=/opt/TGW/tgw-lib/coding-runtime/current/src
ExecStart=/opt/TGW/.venvs/controller/bin/python3 -m tgw.doctor_cli auto-repair --apply
NoNewPrivileges=false
PrivateTmp=true
ProtectHome=read-only

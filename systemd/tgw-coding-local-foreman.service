[Unit]
Description=TGW local Luet coding Foreman
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/TGW/tgw-lib/config/tgw-coding-local.json
ConditionPathExists=/opt/TGW/tgw-lib/coding-runtime/current/src/tgw/development/local_workflow.py

[Service]
Type=oneshot
User=db
Group=db
SupplementaryGroups=tgw-coders
UMask=0002
WorkingDirectory=/opt/TGW/tgw-lib/src/trader-grims-warehouse
Environment=HOME=/home/db
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=PYTHONPATH=/opt/TGW/tgw-lib/coding-runtime/current/src
ExecStart=/opt/TGW/.venvs/controller/bin/python3 -m tgw.development.local_workflow --config /opt/TGW/tgw-lib/config/tgw-coding-local.json foreman
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only

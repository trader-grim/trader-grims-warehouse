[Unit]
Description=TGW local implementation worker (claude executor)
After=postgresql.service
Requires=postgresql.service
ConditionPathExists=/opt/TGW/tgw-lib/config/tgw-coding-local.json
ConditionPathExists=/opt/TGW/tgw-lib/coding-runtime/current/src/tgw/development/local_workflow.py

[Service]
Type=simple
User=claude
Group=claude
SupplementaryGroups=tgw-coders
UMask=0002
WorkingDirectory=/opt/TGW/tgw-lib/coding-runtime/current
Environment=HOME=/home/claude
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=GIT_OPTIONAL_LOCKS=0
Environment=PYTHONPATH=src
Environment=TGW_IMPLEMENT_EXECUTOR=claude
Environment=TGW_CLAUDE_BIN=/home/claude/.local/bin/claude
Environment=ANTHROPIC_MODEL=claude-sonnet-5
ExecStart=/opt/TGW/.venvs/controller/bin/python3 -m tgw.development.local_workflow --config /opt/TGW/tgw-lib/config/tgw-coding-local.json worker --queue codex-implement
Restart=on-failure
RestartSec=5s
TimeoutStopSec=1900s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=off

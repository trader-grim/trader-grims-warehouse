# TGW operator effect-envelope — PP-ROLES-001 WU-9
#
# ============================ OPERATOR REVIEW REQUIRED ========================
# This is the checked-in CANONICAL of the operator effect-envelope sudoers
# grant. It is NOT a finished security boundary until the operator has:
#   1. reviewed the allowlist below and decided which of the existing narrow
#      per-purpose grants it may replace (tgw-flake-git / tgw-source-git belong
#      to the Nix-flake / release lanes and STAY — see PP-ROLES-001 WU-9);
#   2. created group `tgw-operators` at a FIXED GID (see below) and added
#      `claude` + `db` to it;
#   3. run `visudo -cf config/environment/sudoers.d/tgw-operators`;
#   4. installed it, VERIFIED the grant from a fresh login, then removed the
#      `/etc/sudoers.d/90-db-nopasswd` `(db) NOPASSWD: ALL` proxy.
# Until then `tgw doctor` reports `access.operator-sudoers` = UNKNOWN (the group
# does not exist yet), never FAIL.
#
# GID: `tgw-operators` takes the FIXED GID 4000. Rationale:
#   - Debian's `operator` (gid 37) is statically reserved by base-passwd — do
#     NOT reuse it (semantic overload + base-passwd update risk).
#   - `groupadd -r` here allocates downward from 999 (no SYS_GID_MIN in
#     login.defs), landing in the 977-987 band the other tgw-* service groups
#     already crowd — a band package postinsts also use.
#   - 4000-4999 is empty on this host and untouched by any Debian convention or
#     groupadd default; a deliberate `-g 4000` is collision-safe and stable
#     across a host rebuild, so it round-trips through the numeric-identity
#     export in the backup bundle.
# ============================================================================
#
# One group, one curated grant. Members = the operator effect-envelope:
#   - `claude` — the interactive supervised session, TODAY. WU-2 has not built
#     `tgw-triage` yet; until it does, `claude` IS that session. When WU-2 lands,
#     swap: `gpasswd -a tgw-triage tgw-operators && gpasswd -d claude tgw-operators`
#     (tracked in PP-ROLES-001 WU-2).
#   - `db` — transitionally.
# This fragment REPLACES the `(db) NOPASSWD: ALL` proxy in
# /etc/sudoers.d/90-db-nopasswd and the per-purpose grab-bag it subsumes. `db`
# keeps its own personal sudo (operator = highest precedence) but no service or
# agent account routes root access through a human login.
#
# Install (operator, as root, on tgw-lib):
#   groupadd -g 4000 tgw-operators
#   gpasswd -a claude tgw-operators
#   gpasswd -a db tgw-operators
#   visudo -cf config/environment/sudoers.d/tgw-operators
#   install -m 0440 -o root -g root config/environment/sudoers.d/tgw-operators /etc/sudoers.d/tgw-operators
#   # group membership does NOT apply to a running session — verify from a FRESH
#   # login first:
#   #   su - claude -c 'sudo -n systemctl status tgw-context-publish.service'
#   # ONLY once that works:
#   rm -f /etc/sudoers.d/90-db-nopasswd            # the `(db) NOPASSWD: ALL` proxy
#
# Subsumed grants to drop (verified against `sudo -l -U claude` 2026-09-08):
#   - ONLY /etc/sudoers.d/90-db-nopasswd (the `(db) NOPASSWD: ALL` proxy).
# The bare `(root) NOPASSWD: /usr/local/sbin/tgw-coding-bootstrap` in
# `sudo -l -U claude` reaches `claude` via the `tgw-recovery` GROUP
# (/etc/sudoers.d/tgw-recovery) — a separate recovery lane, KEEP it. Every other
# grant is a distinct lane with no overlap with this fragment's (root) tgw-*
# rule and STAYS:
#   (db) tgw-flake-git *          — Nix-flake lane
#   (tgw-release) tgw-git-push    — feature-branch push broker
#   (tgw-release) tgw-source-git *— source -> GitHub broker
#   (tgw-release) tgw-plan-git *  — plan-vault -> GitHub broker (sudoers/tgw-plan-git)
#   (tgw-harness) git ... / harness_cli *  — phase-0 land path (access.harness-sudoers;
#                                            retires when the session runs as tgw-triage)
#   %tgw-recovery tgw-coding-bootstrap, tgw-trace-hooks — recovery / trace lanes
# Verified by: `tgw doctor` check `access.operator-sudoers` (drift/absence -> FAIL).

# --- manage the tgw-* systemd units (the two-gates apparatus + Context) -------
Cmnd_Alias TGW_UNIT_CONTROL = \
    /usr/bin/systemctl start tgw-*, \
    /usr/bin/systemctl stop tgw-*, \
    /usr/bin/systemctl restart tgw-*, \
    /usr/bin/systemctl reload tgw-*, \
    /usr/bin/systemctl enable tgw-*, \
    /usr/bin/systemctl disable tgw-*, \
    /usr/bin/systemctl mask tgw-*, \
    /usr/bin/systemctl unmask tgw-*, \
    /usr/bin/systemctl reset-failed tgw-*, \
    /usr/bin/systemctl daemon-reload

# --- read the tgw-* units + journals (diagnosis) -----------------------------
Cmnd_Alias TGW_UNIT_OBSERVE = \
    /usr/bin/systemctl status tgw-*, \
    /usr/bin/systemctl show tgw-*, \
    /usr/bin/systemctl is-active tgw-*, \
    /usr/bin/systemctl is-enabled tgw-*, \
    /usr/bin/systemctl is-failed tgw-*, \
    /usr/bin/systemctl cat tgw-*, \
    /usr/bin/systemctl list-timers tgw-*, \
    /usr/bin/journalctl -u tgw-*, \
    /usr/bin/journalctl --unit tgw-*, \
    /usr/bin/journalctl --unit=tgw-*

# --- the reviewed coding-runtime bootstrap installer ------------------------
Cmnd_Alias TGW_BOOTSTRAP = \
    /usr/local/sbin/tgw-coding-bootstrap, \
    /usr/local/sbin/tgw-coding-bootstrap *

# A dedicated reviewed launcher installer for /usr/local/{sbin,bin}/tgw-* is
# deferred — until it exists the launcher symlinks are repointed through the
# bootstrap path above. Do NOT add a raw `install`/`cp` wildcard here.

%tgw-operators ALL=(root) NOPASSWD: TGW_UNIT_CONTROL, TGW_UNIT_OBSERVE, TGW_BOOTSTRAP

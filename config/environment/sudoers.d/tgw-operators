# TGW operator effect-envelope — PP-ROLES-001 WU-9
#
# ============================ OPERATOR REVIEW REQUIRED ========================
# This is the checked-in CANONICAL of the operator effect-envelope sudoers
# grant. It is NOT a finished security boundary until the operator has:
#   1. reviewed the allowlist below and decided which of the existing narrow
#      per-purpose grants it may replace (tgw-flake-git / tgw-source-git belong
#      to the Nix-flake / release lanes and STAY — see PP-ROLES-001 WU-9);
#   2. chosen the group: reuse `operator` (gid 37, currently empty) or create a
#      fresh `tgw-operators`;
#   3. run `visudo -cf config/environment/sudoers.d/tgw-operators`;
#   4. installed it (see "Install" below) and removed the
#      `/etc/sudoers.d/90-db-nopasswd` `(db) NOPASSWD: ALL` proxy.
# Until then `tgw doctor` reports `access.operator-sudoers` = UNKNOWN (the group
# does not exist yet), never FAIL.
# ============================================================================
#
# One group, one curated grant. Members = the operator effect-envelope:
# `tgw-triage` (the interactive supervised session, PP-ROLES-001 WU-2) and,
# transitionally, `db`. This fragment REPLACES the `(db) NOPASSWD: ALL` proxy in
# /etc/sudoers.d/90-db-nopasswd and the per-purpose grab-bag it subsumes. `db`
# keeps its own personal sudo (operator = highest precedence) but no service or
# agent account routes root access through a human login.
#
# Install (operator, as root):
#   visudo -cf config/environment/sudoers.d/tgw-operators
#   groupadd -f tgw-operators
#   gpasswd -a tgw-triage tgw-operators        # + `gpasswd -a db tgw-operators` transitionally
#   install -m 0440 -o root -g root config/environment/sudoers.d/tgw-operators /etc/sudoers.d/tgw-operators
#   rm -f /etc/sudoers.d/90-db-nopasswd
#   # then drop the per-purpose grants this subsumes (keep tgw-flake-git, tgw-source-git)
# Verified by: `tgw doctor` check `access.operator-sudoers` (drift/absence -> FAIL).

# --- manage the tgw-* systemd units (the two-gates apparatus + Context) -------
Cmnd_Alias TGW_UNIT_CONTROL = \
    /usr/bin/systemctl start tgw-*, \
    /usr/bin/systemctl stop tgw-*, \
    /usr/bin/systemctl restart tgw-*, \
    /usr/bin/systemctl reload tgw-*, \
    /usr/bin/systemctl enable tgw-*, \
    /usr/bin/systemctl disable tgw-*, \
    /usr/bin/systemctl mask tgw-*, \
    /usr/bin/systemctl unmask tgw-*, \
    /usr/bin/systemctl reset-failed tgw-*, \
    /usr/bin/systemctl daemon-reload

# --- read the tgw-* units + journals (diagnosis) -----------------------------
Cmnd_Alias TGW_UNIT_OBSERVE = \
    /usr/bin/systemctl status tgw-*, \
    /usr/bin/systemctl show tgw-*, \
    /usr/bin/systemctl is-active tgw-*, \
    /usr/bin/systemctl is-enabled tgw-*, \
    /usr/bin/systemctl is-failed tgw-*, \
    /usr/bin/systemctl cat tgw-*, \
    /usr/bin/systemctl list-timers tgw-*, \
    /usr/bin/journalctl -u tgw-*, \
    /usr/bin/journalctl --unit tgw-*, \
    /usr/bin/journalctl --unit=tgw-*

# --- the reviewed coding-runtime bootstrap installer ------------------------
Cmnd_Alias TGW_BOOTSTRAP = \
    /usr/local/sbin/tgw-coding-bootstrap, \
    /usr/local/sbin/tgw-coding-bootstrap *

# A dedicated reviewed launcher installer for /usr/local/{sbin,bin}/tgw-* is
# deferred — until it exists the launcher symlinks are repointed through the
# bootstrap path above. Do NOT add a raw `install`/`cp` wildcard here.

%tgw-operators ALL=(root) NOPASSWD: TGW_UNIT_CONTROL, TGW_UNIT_OBSERVE, TGW_BOOTSTRAP

#!/bin/sh
set -eu

COMMAND=${1:-}
GIT_DIRECTORY=/opt/TGW/tgw-lib/src/trader-grims-warehouse/.git
REMOTE=git@github-tgw-app:trader-grim/trader-grims-warehouse.git
CANDIDATE=repair/application-clean-v1

export HOME=/nonexistent
export PATH=/usr/bin:/bin
export GIT_CONFIG_NOSYSTEM=1
export GIT_TERMINAL_PROMPT=0
export SSH_AUTH_SOCK=/run/tgw-github-agent/agent.sock
cd /

git_repository() {
    git --git-dir="$GIT_DIRECTORY" "$@"
}

remote_commit() {
    git ls-remote --heads "$REMOTE" "$1" | awk 'NR == 1 {print $1}'
}

verify_local_lineage() {
    # Repository identity is semantic, not inferred from a branch name or key.
    # The application repository owns Python/application source. The separate
    # production-flake repository owns host configurations and must never be
    # published through this command.
    git_repository cat-file -e "$CANDIDATE:pyproject.toml"
    git_repository cat-file -e "$CANDIDATE:src/tgw/__init__.py"
    if git_repository cat-file -e "$CANDIDATE:nix/hosts/tgw-prod.nix" 2>/dev/null; then
        echo "refusing production-flake history in application publisher" >&2
        exit 65
    fi
    git_repository cat-file -e "$CANDIDATE^{commit}"
}

verify_remote_readback() {
    name=$1
    local_value=$(git_repository rev-parse "$name^{commit}")
    remote_value=$(remote_commit "refs/heads/$name")
    if [ "$local_value" != "$remote_value" ]; then
        echo "remote $name mismatch: local=$local_value remote=${remote_value:-absent}" >&2
        exit 65
    fi
    echo "$name=$remote_value"
}

case "$COMMAND" in
    status)
        verify_local_lineage
        ssh-keygen -lf /etc/ssh/tgw_github_app.pub
        git ls-remote --heads "$REMOTE" \
            refs/heads/main \
            "refs/heads/$CANDIDATE"
        ;;
    fetch)
        git_repository fetch --no-tags "$REMOTE" \
            '+refs/heads/*:refs/remotes/origin/*'
        ;;
    dry-run-candidate)
        verify_local_lineage
        remote_main=$(remote_commit refs/heads/main)
        if [ -n "$remote_main" ]; then
            git_repository merge-base --is-ancestor "$remote_main" "$CANDIDATE"
        fi
        git_repository push --dry-run "$REMOTE" \
            "refs/heads/$CANDIDATE:refs/heads/$CANDIDATE"
        ;;
    publish-candidate)
        verify_local_lineage
        remote_main=$(remote_commit refs/heads/main)
        if [ -n "$remote_main" ]; then
            git_repository merge-base --is-ancestor "$remote_main" "$CANDIDATE"
        fi
        git_repository push "$REMOTE" \
            "refs/heads/$CANDIDATE:refs/heads/$CANDIDATE"
        verify_remote_readback "$CANDIDATE"
        ;;
    *)
        echo "usage: tgw-source-git {status|fetch|dry-run-candidate|publish-candidate}" >&2
        exit 64
        ;;
esac

#!/bin/sh
set -eu

SOCKET=/run/tgw-github-agent/agent.sock
PRIVATE_KEY=/etc/tgw/credentials/github/trader-grims-warehouse/id_ed25519
attempt=0

while [ ! -S "$SOCKET" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 200 ]; then
        echo "TGW GitHub agent socket did not appear" >&2
        exit 70
    fi
    sleep 0.01
done

chgrp tgw-coders "$SOCKET"
chmod 0660 "$SOCKET"
SSH_AUTH_SOCK="$SOCKET" ssh-add "$PRIVATE_KEY"


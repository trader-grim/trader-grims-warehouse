#!/bin/sh
set -eu

SOCKET=/run/tgw-github-agent/agent.sock
PRIVATE_KEY=/var/lib/tgw-release/.ssh/trader-grims-warehouse_deploy_ed25519
attempt=0

while [ ! -S "$SOCKET" ]; do
    attempt=$((attempt + 1))
    if [ "$attempt" -ge 200 ]; then
        echo "TGW GitHub agent socket did not appear" >&2
        exit 70
    fi
    sleep 0.01
done

chmod 0600 "$SOCKET"
SSH_AUTH_SOCK="$SOCKET" ssh-add "$PRIVATE_KEY"

{
  "schema": "tgw-mcp-registration-policy/v1",
  "harness": "codex",
  "endpoint": "tgw-context",
  "transport": "authenticated-registered-mcp",
  "fallback": "forbidden",
  "role_source": "signed-actor-contract",
  "harness_identity_grants_role": false,
  "allowed_tools": {
    "tgw_context_status": {"arguments": {}},
    "tgw_context_bundle": {"arguments": {"task": {"max_length": 1000}, "receiver": {"enum": ["codex", "claude", "deepseek"]}, "limit": {"minimum": 1, "maximum": 100}}},
    "tgw_context_plan_graph": {"arguments": {"task": {"max_length": 1000}, "receiver": {"enum": ["codex", "claude", "deepseek"]}, "operation": {"enum": ["brief", "resolve", "status"]}, "limit": {"minimum": 1, "maximum": 100}}},
    "tgw_context_plan_source": {"arguments": {"path": {"prefixes": ["plan/", "pp/", "reference/"], "absolute": false, "parent_segments": false}, "start_line": {"minimum": 1}, "max_lines": {"minimum": 1, "maximum": 250}}},
    "tgw_context_runbooks": {"arguments": {"query": {"max_length": 1000}, "path": {"prefixes": ["reference/runbooks/", "docs/runbooks/"], "absolute": false, "parent_segments": false}, "start_line": {"minimum": 1}, "max_lines": {"minimum": 1, "maximum": 250}, "limit": {"minimum": 1, "maximum": 100}, "authority": {"enum": ["all", "current-plan", "approved-plan", "application"]}}},
    "tgw_context_onboarding": {"arguments": {"actor": {"pattern": "^[a-z][a-z0-9_-]{0,63}$"}}},
    "tgw_context_code_graph": {"arguments": {"operation": {"enum": ["status", "query", "capabilities"]}, "query": {"max_length": 1000}, "limit": {"minimum": 1, "maximum": 100}}}
  },
  "write_effects": "none",
  "unregistered_tools": "forbidden",
  "stale_or_mixed_binding": "hold",
  "proposal_only": {"on_missing_capability": true, "has_effect_authority": false, "recipient": "orchestrator"}
}
